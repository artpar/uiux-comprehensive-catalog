---
import { withBase } from "@/lib/paths";
const { updated } = Astro.props as { updated: string };
---
<p class="editorial-byline">By <a href={withBase("/editorial-method/")}>UX Patterns Guide</a><span aria-hidden="true"> · </span>Worked decision updated <time datetime={updated}>{new Date(`${updated}T00:00:00Z`).toLocaleDateString("en", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}</time><span aria-hidden="true"> · </span><a href={withBase("/editorial-method/")}>Editorial method</a></p>
