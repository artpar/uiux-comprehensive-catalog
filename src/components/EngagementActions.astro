---
type Props = {
  id: string;
  title: string;
  summary: string;
  kind: "pattern" | "comparison" | "resource";
};

const { id, title, summary, kind } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`;
---

<div class="engagement-actions" role="group" aria-label={`${title} actions`}>
  <button type="button" data-save-item data-item-id={`${kind}:${id}`} data-item-title={title} data-item-kind={kind} aria-pressed="false">
    <span aria-hidden="true" data-save-icon>+</span><span data-save-label>Save</span>
  </button>
  <button type="button" data-share-page data-share-title={title} data-share-text={summary}>
    <span aria-hidden="true">↗</span><span data-share-label>Share</span>
  </button>
  <a href={linkedInUrl} target="_blank" rel="noopener noreferrer" data-share-linkedin>
    <span aria-hidden="true">in</span><span>LinkedIn</span>
  </a>
  <p data-action-status aria-live="polite"></p>
</div>
