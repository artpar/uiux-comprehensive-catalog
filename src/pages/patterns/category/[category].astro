---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryDescriptions, categoryNames, categorySlug } from "@/lib/categories";
import { getSource, patterns } from "@/lib/catalog";
import { familyGuides } from "@/data/family-guides";
import { familyStudyRoutes, studySequence } from "@/data/family-study-routes";
import { principleForCategory, uiPrinciples } from "@/data/ui-principles";
import { withBase } from "@/lib/paths";
import { affirmative } from "@/lib/lesson-copy";
import { breadcrumbJsonLd, collectionPageJsonLd, pageTitle } from "@/lib/seo";

export function getStaticPaths() {
  return categoryNames.map((category) => ({
    params: { category: categorySlug(category) },
    props: {
      category,
      entries: patterns.filter((pattern) => pattern.category === category)
    }
  }));
}

const { category, entries } = Astro.props;
const guide = familyGuides[category];
const principle = uiPrinciples.find((item) => item.id === principleForCategory[category]);
const starters = guide.starterIds.map((id) => entries.find((entry) => entry.id === id)).filter(Boolean);
const guideSources = [...new Map(starters.flatMap((pattern) => pattern?.sources ?? []).map((ref) => [ref.id, getSource(ref.id)])).values()].filter(Boolean).slice(0, 3);
const route = familyStudyRoutes[category];
const routeIds = studySequence(category);
const routeSections = [
  { title: "Build the foundation", purpose: "Learn the shared task and the core interaction choices.", ids: route.foundations },
  { title: "Apply the patterns", purpose: "Choose a specialized form for the context and follow its complete behavior.", ids: route.applications },
  { title: "Review the quality risks", purpose: "Study failure cases and identify the better recovery route.", ids: route.qualityChecks }
].filter((section) => section.ids.length > 0);
const antiPatternCount = entries.filter((pattern) => pattern.maturity === "anti-pattern").length;
const description = categoryDescriptions[category] ?? `Browse ${category} UX patterns.`;
const categoryPath = `/patterns/category/${categorySlug(category)}/`;
const siteUrl = Astro.site ?? new URL("https://uxpatternsguide.com");
---

<BaseLayout
  title={pageTitle(category)}
  description={description}
  structuredData={[
    collectionPageJsonLd(category, description, categoryPath, siteUrl),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Patterns", path: "/patterns/" },
      { name: category, path: categoryPath }
    ], siteUrl)
  ]}
>
  <nav class="breadcrumb-trail" aria-label="Breadcrumb">
    <a href={withBase("/")}>Home</a>
    <a href={withBase("/patterns/")}>Patterns</a>
    <span aria-current="page">{category}</span>
  </nav>

  <section class="pattern-family-hero" aria-labelledby="family-page-title">
    <div>
      <div class="pattern-kicker">
        <span>{entries.length} documented entries</span>
        {antiPatternCount > 0 && <span>{antiPatternCount} anti-pattern {antiPatternCount === 1 ? "check" : "checks"}</span>}
      </div>
      <h1 id="family-page-title">{category}</h1>
      <p>{description}</p>
      <a class="quiet-link" href={withBase("/patterns/")}>Browse all problem families</a>
    </div>
    <form class="catalog-search family-search" role="search" action={withBase(categoryPath)} method="get" data-family-search>
      <label for="family-query">Filter this family</label>
      <div class="catalog-search-row">
        <input id="family-query" name="q" type="search" autocomplete="off" placeholder="Try approval or recovery" aria-controls="family-pattern-list" data-family-query />
        <button type="submit">Filter</button>
      </div>
      <p aria-live="polite" data-family-status>{entries.length} entries in this family.</p>
    </form>
  </section>

  <section class="family-guide" aria-labelledby="family-guide-title">
    <div class="section-heading"><span>Learn the family</span><h2 id="family-guide-title">{guide.question}</h2><p>{guide.principle}</p></div>
    <div class="family-guide-grid">
      <div><h3>Use this method</h3><ol>{guide.method.map((step) => <li>{step}</li>)}</ol></div>
      <div><h3>Compare the outcome</h3><p><strong>Strong:</strong> {guide.strong}</p><p><strong>Weak:</strong> {guide.weak}</p><p><strong>Try it:</strong> {guide.practice}</p></div>
    </div>
    <div class="family-guide-next"><div><h3>Read these patterns first</h3><ol>{starters.map((pattern) => pattern && <li><a href={withBase(`/patterns/${pattern.id}/`)}>{pattern.name}</a><span>{affirmative(pattern.useWhen, `Study ${pattern.name.toLowerCase()} in a complete task.`)}</span></li>)}</ol></div><div><h3>Build the foundation</h3>{principle && <p><a href={withBase(`/principles/${principle.id}/`)}>{principle.title} →</a></p>}<h3>Follow the evidence</h3><ul>{guideSources.map((source) => source && <li><a href={withBase(`/sources/${source.id}/`)}>{source.name}</a></li>)}</ul></div></div>
  </section>

  <section class="catalog-section" aria-labelledby="family-list-title">
    <div class="section-heading">
      <span>Complete study route · {routeIds.length} entries</span>
      <h2 id="family-list-title">Work through the family in order</h2>
      <p>Begin with the core behavior, apply it in different contexts, then review cases that reveal the quality boundary. Open each entry for its decision rule, states, example, and source trail.</p>
      <p class="family-route-progress" data-family-progress>0 of {routeIds.length} studies complete</p>
      <a class="primary-action family-route-resume" href={withBase(`/patterns/${routeIds[0]}/`)} data-family-resume>Start this family →</a>
    </div>
    <div id="family-pattern-list" tabindex="-1">
      {routeSections.map((section) => <section class="family-route-stage" aria-label={section.title}>
        <div class="section-heading"><span>{section.ids.length} entries</span><h3>{section.title}</h3><p>{section.purpose}</p></div>
        <div class="catalog-card-grid">
          {section.ids.map((id) => {
            const pattern = entries.find((item) => item.id === id);
            if (!pattern) return null;
            const number = routeIds.indexOf(id) + 1;
            return <article class="catalog-card pattern-index-card" data-family-card data-pattern-id={pattern.id} data-search-text={`${pattern.name} ${pattern.aliases.join(" ")} ${pattern.problem} ${pattern.useWhen.join(" ")} ${pattern.maturity}`.toLowerCase()}>
              <span class="family-route-number">Lesson {String(number).padStart(2, "0")} / {routeIds.length}</span>
              <span class="family-route-complete" data-route-complete hidden>Complete ✓</span>
              <h4><a href={withBase(`/patterns/${pattern.id}/`)}>{pattern.name}</a></h4>
              <p>{affirmative(pattern.useWhen, `Study ${pattern.name.toLowerCase()} in a complete task.`)}</p>
              <dl class="pattern-card-facts"><div><dt>Type</dt><dd>{pattern.patternType.toUpperCase()}</dd></div><div><dt>Sources</dt><dd>{pattern.sources.length}</dd></div><div><dt>Trail checked</dt><dd><time datetime={pattern.lastVerified}>{pattern.lastVerified}</time></dd></div></dl>
              <div class="pill-list"><span>{pattern.maturity}</span><span>{pattern.surfaceType}</span></div>
              <a class="quiet-link" href={withBase(`/lab/?pattern=${pattern.id}`)}>Test in lab</a>
            </article>;
          })}
        </div>
      </section>)}
    </div>
    <div class="empty-search-state" data-family-empty hidden>
      <h3>Try another phrase</h3>
      <p>Try fewer words, clear the filter, or search across all pattern families.</p>
      <button type="button" class="secondary-action" data-family-clear>Clear filter</button>
      <a href={withBase("/patterns/")}>Search all patterns</a>
    </div>
  </section>

  <nav class="pattern-family-next" aria-label="More ways to explore">
    <a href={withBase(`/lab/?category=${encodeURIComponent(category)}`)}>Use advanced filters for this family</a>
    <a href={withBase("/compare/")}>Compare named alternatives</a>
    <a href={withBase("/patterns/")}>Choose another family</a>
  </nav>

  <script>
    import { track } from "@/lib/analytics";
    import { readPatternProgress } from "@/lib/pattern-progress";
    import { withBase } from "@/lib/paths";

    const form = document.querySelector("[data-family-search]");
    const input = document.querySelector("[data-family-query]");
    const status = document.querySelector("[data-family-status]");
    const cards = [...document.querySelectorAll("[data-family-card]")];
    const progressLabel = document.querySelector<HTMLElement>("[data-family-progress]");
    const resumeLink = document.querySelector<HTMLAnchorElement>("[data-family-resume]");
    function renderProgress() {
      const progress = readPatternProgress();
      let done = 0;
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const completed = progress.has(card.dataset.patternId || "");
        if (completed) done += 1;
        const label = card.querySelector<HTMLElement>("[data-route-complete]");
        if (label) label.hidden = !completed;
      });
      if (progressLabel) progressLabel.textContent = `${done} of ${cards.length} studies complete`;
      if (resumeLink) {
        const next = cards.find((card) => card instanceof HTMLElement && !progress.has(card.dataset.patternId || ""));
        if (next instanceof HTMLElement) { resumeLink.href = withBase(`/patterns/${next.dataset.patternId}/`); resumeLink.textContent = done ? "Continue this family →" : "Start this family →"; }
        else { resumeLink.href = withBase("/patterns/"); resumeLink.textContent = "Choose another family →"; }
      }
    }
    renderProgress();
    window.addEventListener("pattern-progress-updated", renderProgress);
    const empty = document.querySelector("[data-family-empty]");
    const clear = document.querySelector("[data-family-clear]");
    let trackingTimer: number | undefined;
    function normalize(value: string) { return value.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim(); }
    function render(query: string) {
      const terms = normalize(query).split(" ").filter(Boolean);
      let count = 0;
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const haystack = normalize(card.dataset.searchText || "");
        card.hidden = !terms.every((term) => haystack.includes(term));
        if (!card.hidden) count += 1;
      });
      if (status instanceof HTMLElement) status.textContent = terms.length ? `${count} ${count === 1 ? "entry matches" : "entries match"} “${query.trim()}”.` : `${cards.length} entries in this family.`;
      if (empty instanceof HTMLElement) empty.hidden = count !== 0;
      const url = new URL(window.location.href);
      if (query.trim()) url.searchParams.set("q", query.trim()); else url.searchParams.delete("q");
      window.history.replaceState(null, "", `${url.pathname}${url.search}`);
      window.clearTimeout(trackingTimer);
      if (terms.length) trackingTimer = window.setTimeout(() => {
        track("catalog_filter", { surface: "pattern_family", queryLength: query.trim().length, resultCount: count });
        if (count === 0) track("zero_result_search", { surface: "pattern_family", queryLength: query.trim().length });
      }, 700);
    }
    if (form instanceof HTMLFormElement) form.addEventListener("submit", (event) => { event.preventDefault(); render(input instanceof HTMLInputElement ? input.value : ""); });
    if (input instanceof HTMLInputElement) input.addEventListener("input", () => render(input.value));
    if (clear instanceof HTMLButtonElement) clear.addEventListener("click", () => { if (input instanceof HTMLInputElement) { input.value = ""; input.focus(); } render(""); });
    const initialQuery = new URLSearchParams(window.location.search).get("q") || "";
    if (input instanceof HTMLInputElement && initialQuery) { input.value = initialQuery; render(initialQuery); }
  </script>
</BaseLayout>
