---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryDescriptions, categoryNames, categorySlug } from "@/lib/categories";
import { patterns } from "@/lib/catalog";
import { withBase } from "@/lib/paths";
import { breadcrumbJsonLd, collectionPageJsonLd, pageTitle } from "@/lib/seo";

const families = categoryNames.map((category) => {
  const entries = patterns.filter((pattern) => pattern.category === category);
  return {
    category,
    description: categoryDescriptions[category],
    count: entries.length,
    antiPatternCount: entries.filter((pattern) => pattern.maturity === "anti-pattern").length,
    sampleNames: entries.slice(0, 3).map((pattern) => pattern.name)
  };
});
const featuredIds = [
  "human-approval-gate", "source-grounding-display", "empty-state", "error-state",
  "inline-validation", "no-results-recovery", "destructive-action-confirmation", "progressive-disclosure"
];
const featuredPatterns = featuredIds
  .map((id) => patterns.find((pattern) => pattern.id === id))
  .filter((pattern) => Boolean(pattern));
const sourceClaimCount = patterns.reduce((total, pattern) => total + pattern.sources.length, 0);
const siteUrl = Astro.site ?? new URL("https://uxpatternsguide.com");
const description = "Browse practical UX and UI patterns by family, with source-backed guidance, implementation checks, and interactive examples.";
---

<BaseLayout
  title={pageTitle("UX and UI Patterns")}
  description={description}
  structuredData={[
    collectionPageJsonLd("UX and UI Patterns", description, "/patterns/", siteUrl),
    breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Patterns", path: "/patterns/" }], siteUrl)
  ]}
>
  <nav class="breadcrumb-trail" aria-label="Breadcrumb">
    <a href={withBase("/")}>Home</a>
    <span aria-current="page">Patterns</span>
  </nav>

  <section class="pattern-directory-hero" aria-labelledby="patterns-title">
    <div>
      <div class="pattern-kicker">
        <span>{patterns.length} documented entries</span>
        <span>{families.length} problem families</span>
        <span>{sourceClaimCount} source references</span>
      </div>
      <h1 id="patterns-title">Find a pattern by the problem you need to solve</h1>
      <p>{description} Start with search when you can describe the problem; browse a family when you are still framing it.</p>
      <div class="pattern-hero-actions">
        <a class="primary-action" href={withBase("/lab/")}>Open interactive lab</a>
        <a class="secondary-action" href={withBase("/compare/")}>Compare alternatives</a>
      </div>
    </div>

    <form class="catalog-search pattern-directory-search" role="search" action={withBase("/patterns/")} method="get" data-pattern-index-search data-search-index-url={withBase("/pattern-search.json")}>
      <label for="pattern-index-query">Search by problem, state, or pattern name</label>
      <div class="catalog-search-row">
        <input id="pattern-index-query" name="q" type="search" autocomplete="off" placeholder="Try recovering from no results" aria-controls="pattern-search-output" data-pattern-index-query />
        <button type="submit">Search</button>
      </div>
      <p>Use two or three specific terms for a shorter list.</p>
    </form>
  </section>

  <section id="pattern-search-output" class="catalog-section pattern-search-output" aria-labelledby="pattern-search-title" data-pattern-search-output hidden>
    <div class="section-heading">
      <h2 id="pattern-search-title" tabindex="-1" data-pattern-search-title>Search results</h2>
      <p aria-live="polite" data-pattern-search-status></p>
    </div>
    <div class="catalog-card-grid" data-pattern-search-grid></div>
    <div class="pattern-search-actions">
      <button type="button" class="secondary-action" data-pattern-search-clear>Clear search</button>
      <a href={withBase("/lab/")}>Use advanced filters in the lab</a>
    </div>
  </section>

  <section class="catalog-section" aria-labelledby="family-title">
    <div class="section-heading">
      <span>Browse</span>
      <h2 id="family-title">Choose a problem family</h2>
      <p>Each family has its own focused index, so you can scan related options without loading the entire catalog at once.</p>
    </div>
    <div class="pattern-family-grid">
      {families.map((family) => (
        <article class="pattern-family-card" id={categorySlug(family.category)}>
          <div>
            <h3><a href={withBase(`/patterns/category/${categorySlug(family.category)}/`)}>{family.category}</a></h3>
            <p>{family.description}</p>
          </div>
          <p class="pattern-family-examples">Includes {family.sampleNames.join(", ")}</p>
          <div class="pattern-family-meta">
            <span>{family.count} entries</span>
            {family.antiPatternCount > 0 && <span>{family.antiPatternCount} anti-pattern {family.antiPatternCount === 1 ? "check" : "checks"}</span>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="catalog-section catalog-two-column" aria-labelledby="starting-points-title">
    <div>
      <div class="section-heading">
        <span>Starting points</span>
        <h2 id="starting-points-title">Frequently useful decisions</h2>
        <p>Use these when you want a concrete entry before narrowing the catalog.</p>
      </div>
      <div class="featured-list">
        {featuredPatterns.map((pattern) => pattern && (
          <article class="featured-row">
            <h3><a href={withBase(`/patterns/${pattern.id}/`)}>{pattern.name}</a></h3>
            <p>{pattern.useWhen[0] ?? pattern.problem}</p>
            <span>{pattern.category} · {pattern.sources.length} source {pattern.sources.length === 1 ? "reference" : "references"}</span>
          </article>
        ))}
      </div>
    </div>

    <aside class="catalog-method-note" aria-labelledby="terms-title">
      <p class="eyebrow">Read the labels honestly</p>
      <h2 id="terms-title">Evidence is context, not a universal verdict</h2>
      <dl>
        <div><dt>Source trail checked</dt><dd>The linked references were reviewed on the shown date. It does not mean every implementation was usability-tested.</dd></div>
        <div><dt>Established or standard</dt><dd>A maturity signal based on recurring guidance and usage, not a guarantee that the pattern fits your users.</dd></div>
        <div><dt>Documented entry</dt><dd>The catalog fields and review checks are filled in. “Documented” does not mean “proven.”</dd></div>
      </dl>
      <a href={withBase("/sources/")}>Inspect the evidence library</a>
    </aside>
  </section>

  <script>
    import { track } from "@/lib/analytics";
    type PatternSearchEntry = { id: string; name: string; category: string; maturity: string; surfaceType: string; problem: string; useWhen: string; href: string; searchText: string };

    const form = document.querySelector("[data-pattern-index-search]");
    const input = document.querySelector("[data-pattern-index-query]");
    const output = document.querySelector("[data-pattern-search-output]");
    const title = document.querySelector("[data-pattern-search-title]");
    const status = document.querySelector("[data-pattern-search-status]");
    const grid = document.querySelector("[data-pattern-search-grid]");
    const clear = document.querySelector("[data-pattern-search-clear]");
    let searchDataPromise: Promise<PatternSearchEntry[]> | undefined;
    let sequence = 0;

    function normalize(value: string) { return value.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim(); }
    function searchData() {
      if (searchDataPromise) return searchDataPromise;
      const url = form instanceof HTMLElement ? form.dataset.searchIndexUrl : undefined;
      searchDataPromise = fetch(url || "/pattern-search.json")
        .then((response) => { if (!response.ok) throw new Error("Search index unavailable"); return response.json(); })
        .catch(() => []) as Promise<PatternSearchEntry[]>;
      return searchDataPromise;
    }
    function syncUrl(query: string) {
      const url = new URL(window.location.href);
      if (query.trim()) url.searchParams.set("q", query.trim()); else url.searchParams.delete("q");
      window.history.replaceState(null, "", `${url.pathname}${url.search}`);
    }
    function addResult(pattern: PatternSearchEntry) {
      if (!(grid instanceof HTMLElement)) return;
      const card = document.createElement("article"); card.className = "catalog-card pattern-index-card";
      const heading = document.createElement("h3"); const link = document.createElement("a");
      link.href = pattern.href; link.textContent = pattern.name; heading.append(link);
      const summary = document.createElement("p"); summary.textContent = pattern.useWhen || pattern.problem;
      const meta = document.createElement("p"); meta.className = "pattern-result-meta";
      meta.textContent = `${pattern.category} · ${pattern.maturity.replaceAll("-", " ")} · ${pattern.surfaceType}`;
      card.append(heading, summary, meta); grid.append(card);
    }
    async function render(query: string, moveFocus = false) {
      const current = ++sequence; const terms = normalize(query).split(" ").filter(Boolean);
      if (terms.length === 0) { if (output instanceof HTMLElement) output.hidden = true; if (grid instanceof HTMLElement) grid.replaceChildren(); return; }
      if (output instanceof HTMLElement) output.hidden = false;
      if (status instanceof HTMLElement) status.textContent = "Searching the catalog…";
      if (grid instanceof HTMLElement) grid.replaceChildren();
      const data = await searchData(); if (current !== sequence) return;
      const matches = data.filter((pattern) => terms.every((term) => normalize(pattern.searchText).includes(term)));
      const visibleMatches = matches.slice(0, 48); visibleMatches.forEach(addResult);
      if (status instanceof HTMLElement) {
        if (data.length === 0) status.textContent = "Search is temporarily unavailable. Browse a problem family below.";
        else if (matches.length === 0) status.textContent = `No patterns match “${query.trim()}”. Try fewer terms or browse a family below.`;
        else if (matches.length > visibleMatches.length) status.textContent = `${matches.length} patterns match “${query.trim()}”. Showing the first ${visibleMatches.length}; add another term to narrow the list.`;
        else status.textContent = `${matches.length} ${matches.length === 1 ? "pattern matches" : "patterns match"} “${query.trim()}”.`;
      }
      if (moveFocus && title instanceof HTMLElement) title.focus();
      track("catalog_search", { surface: "pattern_directory", queryLength: query.trim().length, resultCount: matches.length });
      if (matches.length === 0) track("zero_result_search", { surface: "pattern_directory", queryLength: query.trim().length });
    }
    if (form instanceof HTMLFormElement) form.addEventListener("submit", (event) => { event.preventDefault(); const query = input instanceof HTMLInputElement ? input.value : ""; syncUrl(query); render(query, true); });
    if (clear instanceof HTMLButtonElement) clear.addEventListener("click", () => { if (input instanceof HTMLInputElement) { input.value = ""; input.focus(); } syncUrl(""); render(""); });
    const initialQuery = new URLSearchParams(window.location.search).get("q") || "";
    if (input instanceof HTMLInputElement && initialQuery) { input.value = initialQuery; render(initialQuery); }
  </script>
</BaseLayout>
