---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EngagementActions from "@/components/EngagementActions.astro";
import { categorySlug } from "@/lib/categories";
import { comparisons, getComparison, getPattern, getSource, patterns } from "@/lib/catalog";
import { withBase } from "@/lib/paths";
import { affirmative, affirmativeMany } from "@/lib/lesson-copy";
import { absoluteUrl, breadcrumbJsonLd, pageTitle, SITE_NAME } from "@/lib/seo";
import type { ComparisonEntry, PatternEntry } from "@/schemas/catalog";
import { learningLessons } from "@/data/learning";
import { workflowForStage } from "@/data/workflows";
import { familyGuides } from "@/data/family-guides";
import { familyStudyRoutes, studySequence } from "@/data/family-study-routes";
import { principleForCategory, uiPrinciples } from "@/data/ui-principles";

function isPattern(value: PatternEntry | undefined): value is PatternEntry {
  return Boolean(value);
}

function isComparison(value: ComparisonEntry | undefined): value is ComparisonEntry {
  return Boolean(value);
}

export function getStaticPaths() {
  return patterns.map((pattern) => ({
    params: { id: pattern.id },
    props: { pattern }
  }));
}

const { pattern } = Astro.props;
const familyGuide = familyGuides[pattern.category];
const familyRoute = familyStudyRoutes[pattern.category];
const familySequence = studySequence(pattern.category);
const routeIndex = familySequence.indexOf(pattern.id);
const previousPattern = routeIndex > 0 ? getPattern(familySequence[routeIndex - 1]) : undefined;
const nextPattern = routeIndex < familySequence.length - 1 ? getPattern(familySequence[routeIndex + 1]) : undefined;
const routeStage = familyRoute.foundations.includes(pattern.id) ? "Foundation" : familyRoute.applications.includes(pattern.id) ? "Application" : "Quality check";
const lessonUse = affirmative(pattern.useWhen, `Use ${pattern.name.toLowerCase()} for the task shown in the worked example.`);
const lessonNeed = affirmative(pattern.problemContext, lessonUse);
const lessonSolution = affirmative([pattern.solution, ...pattern.uxGuidance, ...pattern.selectionRules], lessonUse);
const lessonState = affirmative(pattern.requiredStates, `Show the current state and the person's next action.`);
const lessonReview = affirmative(pattern.critiqueQuestions, `Can a person complete this task and explain the result?`);
const lessonContract = affirmative(pattern.interactionContract, lessonState);
const lessonRecovery = affirmative(pattern.failureModes, "The person needs a visible route to correct the result and continue the task.");
const lessonAccess = affirmative([...pattern.accessibility, ...pattern.keyboardBehavior], "Give the person a clear label, focus path, and operable control.");
const lessonUseList = affirmativeMany(pattern.useWhen, 4, lessonUse);
const lessonAlternativeList = affirmativeMany(pattern.avoidWhen, 4, "Choose an alternative when the task calls for a different interaction.");
const strongExamples = affirmativeMany([...pattern.uiExamples.good, ...pattern.uxExamples.good], 4, "The person understands the action and reaches the intended result.");
const weakExamples = affirmativeMany([...pattern.uiExamples.bad, ...pattern.uxExamples.bad, ...pattern.failureModes], 4, "The interface leaves the next action unclear and adds recovery work.");
const relatedPrinciple = uiPrinciples.find((item) => item.id === principleForCategory[pattern.category]);
const sourceRefs = pattern.sources.map((ref) => ({ ref, source: getSource(ref.id) }));
const related = pattern.relatedPatterns.map((id) => getPattern(id)).filter(isPattern);
const uniqueRelated = [...new Map(related.map((item) => [item.id, item])).values()];
const patternComparisons = pattern.comparisons.map((id) => getComparison(id)).filter(isComparison);
const referencedByComparisons = comparisons.filter((comparison) => comparison.patternIds.includes(pattern.id));
const allComparisons = [...new Map([...patternComparisons, ...referencedByComparisons].map((item) => [item.id, item])).values()];
const primaryComparison = allComparisons[0];
const relatedLessons = learningLessons.filter((lesson) => lesson.patternIds.includes(pattern.id)).slice(0, 2);
const relatedWorkflow = relatedLessons[0] && workflowForStage(relatedLessons[0].stage);
const anatomyItems = [
  { label: "User need", value: lessonNeed },
  { label: "Pattern promise", value: lessonSolution },
  { label: "Required state", value: lessonState },
  { label: "Failure to inspect", value: lessonRecovery },
  {
    label: "Access contract",
    value: lessonAccess
  }
];
const implementationGroups = [
  { label: "States", items: affirmativeMany(pattern.requiredStates, 4, lessonState) },
  { label: "Interaction", items: affirmativeMany(pattern.interactionContract, 4, lessonContract) },
  { label: "Accessibility", items: affirmativeMany([...pattern.accessibility, ...pattern.keyboardBehavior], 4, lessonAccess) },
  { label: "Review", items: affirmativeMany(pattern.critiqueQuestions, 4, lessonReview) }
];
const siteUrl = Astro.site ?? new URL("https://uxpatternsguide.com");
const patternKind = pattern.maturity === "anti-pattern" ? "UX Anti-pattern" : "UX Pattern";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: `${pattern.name} ${patternKind}`,
    name: pattern.name,
    description: pattern.problem,
    url: absoluteUrl(`/patterns/${pattern.id}/`, siteUrl),
    dateModified: pattern.lastVerified,
    inLanguage: "en",
    about: [pattern.category, pattern.surfaceType, ...pattern.aliases],
    citation: sourceRefs
      .map(({ source }) => source?.url)
      .filter(Boolean),
    isPartOf: {
      "@type": "WebSite",
      name: SITE_NAME,
      url: absoluteUrl("/", siteUrl)
    },
    publisher: {
      "@type": "Organization",
      name: SITE_NAME,
      url: absoluteUrl("/", siteUrl)
    }
  },
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Patterns", path: "/patterns/" },
    { name: pattern.category, path: `/patterns/category/${categorySlug(pattern.category)}/` },
    { name: pattern.name, path: `/patterns/${pattern.id}/` }
  ], siteUrl)
];
---

<BaseLayout title={pageTitle(`${pattern.name} ${patternKind}`)} description={pattern.problem} structuredData={structuredData}>
  <div class="pattern-learning-shell">
    <nav class="pattern-learning-rail" aria-label="On this page">
      <strong>Pattern workspace</strong>
      <a class="is-active" href="#pattern-title">Overview</a>
      <a href="#study">Understand the pattern</a>
      <a href="#decision">Decide when to use it</a>
      <a href="#lab">Try the behavior</a>
      <a href="#quality">See the quality bar</a>
      <a href="#contract">Implementation</a>
      <a href="#evidence">Sources</a>
    </nav>

    <section class="pattern-learning-main" aria-labelledby="pattern-title">
      <nav class="breadcrumb-trail" aria-label="Breadcrumb"><a href={withBase("/patterns/")}>Patterns</a><a href={withBase(`/patterns/category/${categorySlug(pattern.category)}/`)}>{pattern.category}</a><span aria-current="page">{pattern.name}</span></nav>
      <p class="pattern-learning-eyebrow">{routeStage} · lesson {routeIndex + 1} of {familySequence.length} · {pattern.category}</p>
      <h1 id="pattern-title">{pattern.name}</h1>
      <p class="pattern-learning-principle"><strong>Underlying principle:</strong> {familyGuide.principle}</p>
      <p class="pattern-learning-lead">{lessonSolution}</p>
      <div class="pattern-next-card"><div><span>Start with the decision</span><h2>Does this fit your task?</h2><p>{lessonUse}</p><p class="pattern-next-caution"><strong>Review the boundary:</strong> Compare the task with the alternatives in the decision section.</p></div><a class="primary-action" href="#decision">Review the decision →</a></div>
      <div class="pattern-learning-actions"><a href={withBase(`/lab/?pattern=${pattern.id}`)}>Try the live example →</a>{primaryComparison && <a href={withBase(`/compare/${primaryComparison.id}/`)}>Compare alternatives →</a>}<EngagementActions id={pattern.id} title={pattern.name} summary={pattern.solution} kind="pattern" /></div>
    </section>

    <aside class="pattern-learning-side" aria-label="Continue learning">
      <div class="pattern-learning-side-card"><h2>Develop this skill</h2>{relatedLessons.length > 0 ? <><p>{relatedLessons[0].title}</p><a href={withBase(`/learn/${relatedLessons[0].id}/`)}>Open related lesson →</a></> : relatedPrinciple ? <><p>{relatedPrinciple.outcome}</p><a href={withBase(`/principles/${relatedPrinciple.id}/`)}>Study the principle →</a></> : <><p>Follow the connected learning path.</p><a href={withBase("/learn/")}>Open the course →</a></>}</div>
      <div class="pattern-learning-side-card"><h2>In your work</h2><p>{lessonReview}</p><a href={withBase(relatedWorkflow ? `/work/${relatedWorkflow.id}/` : "/work/")}>{relatedWorkflow ? `Use ${relatedWorkflow.title} →` : "Use a guided work tool →"}</a></div>
      <div class="pattern-learning-side-card"><h2>Source trail</h2><p>{pattern.sources.length} linked sources · checked <time datetime={pattern.lastVerified}>{pattern.lastVerified}</time></p><a href="#evidence">See the evidence →</a></div>
    </aside>
  </div>

  <section class="pattern-study" id="study" aria-labelledby="pattern-study-title">
    <div class="section-heading"><span>Study the interaction</span><h2 id="pattern-study-title">Follow the task before choosing the component</h2><p>{familyGuide.principle}</p></div>
    <div class="pattern-study-grid">
      <article><span>01 / Recognize the need</span><h3>What the person is doing</h3><p>{lessonNeed}</p></article>
      <article><span>02 / Design the response</span><h3>What the interface must communicate</h3><p>{lessonSolution}</p><p>{lessonState}</p></article>
      <article><span>03 / Judge the outcome</span><h3>What to look for</h3><p>{lessonReview}</p><p>{lessonContract}</p></article>
    </div>
    <div class="pattern-study-footer"><p><strong>Practice this pattern:</strong> Sketch {pattern.name.toLowerCase()} for this situation: {lessonUse} Include this state: {lessonState} Review your sketch with this question: {lessonReview}</p><a href={withBase(`/patterns/category/${categorySlug(pattern.category)}/`)}>Study the {pattern.category} family →</a>{relatedPrinciple && <a href={withBase(`/principles/${relatedPrinciple.id}/`)}>Read the underlying principle →</a>}</div>
  </section>

  <nav class="pattern-page-nav" aria-label="Pattern sections">
    <a href="#study">Study</a>
    <a href="#decision">Decision</a>
    <a href="#lab">Try it</a>
    <a href="#anatomy">Anatomy</a>
    <a href="#quality">Examples</a>
    <a href="#contract">Contract</a>
    <a href="#evidence">Evidence</a>
  </nav>

  <section class="pattern-decision-board" id="decision" aria-labelledby="decision-heading">
    <div class="section-heading">
      <span>Decision first</span>
      <h2 id="decision-heading">Choose this pattern when the problem matches</h2>
    </div>
    <div class="decision-matrix">
      <article class="decision-cell decision-cell-strong">
        <h3>Use when</h3>
        <ul>{lessonUseList.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article class="decision-cell">
        <h3>Avoid when</h3>
        <ul>{lessonAlternativeList.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article class="decision-cell">
        <h3>Problem it prevents</h3>
        <p>{lessonNeed}</p>
      </article>
    </div>
  </section>

  <section class="pattern-lab-section pattern-lab-priority" id="lab" aria-labelledby="lab-heading">
    <div class="section-heading">
      <span>Test the behavior</span>
      <h2 id="lab-heading">Open the interactive example when you need it</h2>
      <p>The full lab is intentionally loaded on request. That keeps this reading page fast while preserving the strong and weak states, keyboard checks, and failure scenarios.</p>
    </div>
    <div class="pattern-lab-launch">
      <div>
        <strong>In the lab you can</strong>
        <ul>
          <li>switch between strong UI, weak UI, strong UX, and weak UX;</li>
          <li>trigger required, empty, loading, error, and recovery states;</li>
          <li>inspect keyboard and accessibility expectations beside the demo.</li>
        </ul>
      </div>
      <a class="primary-action" href={withBase(`/lab/?pattern=${pattern.id}`)}>Launch {pattern.name} in the lab</a>
    </div>
  </section>

  <div class="pattern-workspace pattern-expert-layout">
    <div class="pattern-reading">
      <section class="pattern-reading-section pattern-anatomy" id="anatomy" aria-labelledby="pattern-anatomy-heading">
        <div class="section-heading">
          <span>Pattern anatomy</span>
          <h2 id="pattern-anatomy-heading">What a strong implementation has to make clear</h2>
        </div>
        <div class="anatomy-list">
          {anatomyItems.map((item) => (
            <article class="anatomy-row">
              <span>{item.label}</span>
              <p>{item.value}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="pattern-reading-section" id="quality" aria-labelledby="pattern-quality-heading">
        <div class="section-heading">
          <span>Quality bar</span>
          <h2 id="pattern-quality-heading">The difference between expert and weak execution</h2>
        </div>
        <div class="quality-comparison">
          <article class="quality-column quality-column-strong">
            <div>
              <span>Strong implementation</span>
              <h3>Specific, visible, recoverable</h3>
            </div>
            <ul>
              {strongExamples.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article class="quality-column quality-column-weak">
            <div>
              <span>Weak implementation</span>
              <h3>Vague, hidden, hard to recover from</h3>
            </div>
            <ul>
              {weakExamples.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
        <div class="guidance-pair">
          <details class="guidance-block guidance-details">
            <summary>UI guidance</summary>
            <ul>{pattern.uiGuidance.map((item) => <li>{item}</li>)}</ul>
          </details>
          <details class="guidance-block guidance-details">
            <summary>UX guidance</summary>
            <ul>{pattern.uxGuidance.map((item) => <li>{item}</li>)}</ul>
          </details>
        </div>
      </section>

      <section class="pattern-reading-section implementation-contract" id="contract" aria-labelledby="implementation-heading">
        <div class="section-heading">
          <span>Implementation contract</span>
          <h2 id="implementation-heading">What the implementation must handle</h2>
        </div>
        <div class="contract-table">
          {implementationGroups.map((group) => (
            <article class="contract-row">
              <h3>{group.label}</h3>
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </section>

      <section class="pattern-reading-section evidence-section" id="evidence" aria-labelledby="evidence-heading">
        <div class="section-heading">
          <span>Evidence trail</span>
          <h2 id="evidence-heading">Source-backed claims behind this guidance</h2>
        </div>
        <div class="evidence-list">
          {sourceRefs.map(({ ref, source }) => (
            <article class="evidence-row">
              <div>
                <h3>
                  {source ? (
                    <a
                      href={withBase(`/sources/${source.id}/`)}
                      data-analytics-event="evidence_opened"
                      data-surface="pattern_detail"
                      data-source-id={source.id}
                      data-pattern-id={pattern.id}
                    >
                      {source.name}
                    </a>
                  ) : ref.id}
                </h3>
                {source && <p>{source.publisher ?? source.type} - checked <time datetime={source.checkedAt}>{source.checkedAt}</time></p>}
              </div>
              <p>{ref.note}</p>
            </article>
          ))}
        </div>
      </section>

      <details class="guidance-block guidance-details agent-panel">
        <summary>Full agent/debug reference</summary>
        <h3>Problem Context</h3>
        <ul>{pattern.problemContext.map((item) => <li>{item}</li>)}</ul>

        <h3>Selection Rules</h3>
        <ul>{pattern.selectionRules.map((item) => <li>{item}</li>)}</ul>

        <h3>Required States</h3>
        <ul>{pattern.requiredStates.map((item) => <li>{item}</li>)}</ul>

        <h3>Interaction Contract</h3>
        <ul>{pattern.interactionContract.map((item) => <li>{item}</li>)}</ul>

        <h3>Implementation Checklist</h3>
        <ul>{pattern.implementationChecklist.map((item) => <li>{item}</li>)}</ul>

        <h3>Common Generated-UI Mistakes</h3>
        <ul>{pattern.commonMisuses.map((item) => <li>{item}</li>)}</ul>

        <h3>Critique Questions</h3>
        <ul>{pattern.critiqueQuestions.map((item) => <li>{item}</li>)}</ul>
      </details>
    </div>

    <aside class="pattern-sidebar pattern-expert-sidebar" aria-label="Pattern quick navigation">
      <section class="sidebar-panel">
        <h2>Review checklist</h2>
        <ul>{affirmativeMany(pattern.critiqueQuestions, 4, lessonReview).map((item) => <li>{item}</li>)}</ul>
      </section>

      {pattern.commonMisuses.length > 0 && (
        <section class="sidebar-panel">
          <h2>Common mistakes</h2>
          <ul>{affirmativeMany(pattern.commonMisuses, 4, lessonRecovery).map((item) => <li>{item}</li>)}</ul>
        </section>
      )}

      {uniqueRelated.length > 0 && (
        <section class="sidebar-panel">
          <h2>Related patterns</h2>
          <ul>
            {uniqueRelated.slice(0, 6).map((item) => (
              <li><a href={withBase(`/patterns/${item.id}/`)}>{item.name}</a></li>
            ))}
          </ul>
        </section>
      )}

      {allComparisons.length > 0 && (
        <section class="sidebar-panel">
          <h2>Compare with</h2>
          <ul>
            {allComparisons.slice(0, 4).map((item) => (
              <li><a href={withBase(`/compare/${item.id}/`)}>{item.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <details class="sidebar-panel sidebar-disclosure">
        <summary>Reference fields</summary>
        <div class="sidebar-reference">
          <h3>Aliases</h3>
          <div class="pill-list">
            {pattern.aliases.length ? pattern.aliases.slice(0, 8).map((alias) => <span>{alias}</span>) : <span>None</span>}
          </div>
          {pattern.variants.length > 0 && (
            <>
              <h3>Variants</h3>
              <ul>{pattern.variants.slice(0, 8).map((item) => <li>{item}</li>)}</ul>
            </>
          )}
          {pattern.failureModes.length > 0 && (
            <>
              <h3>Failure modes</h3>
              <ul>{pattern.failureModes.slice(0, 6).map((item) => <li>{item}</li>)}</ul>
            </>
          )}
        </div>
      </details>
    </aside>
  </div>

  <section class="reference-grid pattern-reference-archive" aria-label="Pattern reference archive">
    {pattern.accessibility.length > 0 && (
      <details class="guidance-block guidance-details">
        <summary>Accessibility</summary>
        <ul>{pattern.accessibility.map((item) => <li>{item}</li>)}</ul>
      </details>
    )}

    {pattern.keyboardBehavior.length > 0 && (
      <details class="guidance-block guidance-details">
        <summary>Keyboard Behavior</summary>
        <ul>{pattern.keyboardBehavior.map((item) => <li>{item}</li>)}</ul>
      </details>
    )}

    {pattern.variants.length > 0 && (
      <details class="guidance-block guidance-details">
        <summary>Variants</summary>
        <ul>{pattern.variants.map((item) => <li>{item}</li>)}</ul>
      </details>
    )}

    <section class="guidance-block verification-strip">
      <h2>Verification</h2>
      <p>Source trail checked: <time datetime={pattern.lastVerified}>{pattern.lastVerified}</time></p>
    </section>
  </section>
  <nav class="pattern-study-navigation" aria-label="Continue the family study route">
    <div><span>{routeStage} · {routeIndex + 1} of {familySequence.length}</span><strong>Continue this pattern family</strong></div>
    <button type="button" data-complete-pattern={pattern.id}>Mark lesson complete</button><span role="status" data-pattern-progress-status></span>
    {previousPattern && <a href={withBase(`/patterns/${previousPattern.id}/`)}>← {previousPattern.name}</a>}
    {nextPattern && <a href={withBase(`/patterns/${nextPattern.id}/`)}>{nextPattern.name} →</a>}
    {!nextPattern && <a href={withBase("/patterns/")}>Choose another family →</a>}
  </nav>
  <script>
    import { completePatternStudy, readPatternProgress } from "@/lib/pattern-progress";
    const button = document.querySelector<HTMLButtonElement>("[data-complete-pattern]");
    const status = document.querySelector<HTMLElement>("[data-pattern-progress-status]");
    if (button) {
      const id = button.dataset.completePattern || "";
      if (readPatternProgress().has(id)) { button.textContent = "Lesson complete ✓"; button.disabled = true; }
      button.addEventListener("click", () => {
        if (completePatternStudy(id)) { button.textContent = "Lesson complete ✓"; button.disabled = true; if (status) status.textContent = "Progress saved in this browser."; window.dispatchEvent(new Event("pattern-progress-updated")); }
        else if (status) status.textContent = "Continue to the next pattern and keep your notes nearby.";
      });
    }
  </script>
</BaseLayout>
