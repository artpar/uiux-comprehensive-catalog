---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { learningLessons, learningStages, lessonIndex } from "@/data/learning";
import { workflowForStage } from "@/data/workflows";
import { withBase } from "@/lib/paths";
import { pageTitle } from "@/lib/seo";

export function getStaticPaths() {
  return learningLessons.map((lesson) => ({ params: { id: lesson.id }, props: { lesson } }));
}

const { lesson } = Astro.props;
const index = lessonIndex(lesson.id);
const stage = learningStages.find((item) => item.id === lesson.stage);
const next = learningLessons[index + 1];
const previous = learningLessons[index - 1];
const relatedWorkflow = workflowForStage(lesson.stage);
const endsUnit = !next || next.stage !== lesson.stage;
---

<BaseLayout title={pageTitle(lesson.title)} description={lesson.outcome}>
  <article class="learning-page lesson-page" data-lesson-id={lesson.id} data-feedbacks={JSON.stringify(lesson.options.map((option) => option.feedback))}>
    <nav class="learning-breadcrumb" aria-label="Breadcrumb"><a href={withBase("/learn/")}>Learn</a><span aria-hidden="true">/</span><span>{stage?.title}</span></nav>
    <header class="learning-hero lesson-hero">
      <div><p class="learning-eyebrow">Unit {learningStages.findIndex((item) => item.id === lesson.stage) + 1} · Lesson {index + 1} of {learningLessons.length}</p><h1>{lesson.title}</h1><p class="learning-lead">{lesson.outcome}</p></div>
      <div class="learning-progress-card lesson-status-card"><span class="lesson-status-icon" aria-hidden="true">✦</span><strong data-lesson-status>Ready to learn</strong><span>One idea, one guided decision, and an application in a new context.</span></div>
    </header>
    <div class="lesson-overall-progress"><span>YOUR LEARNING PATH</span><div role="progressbar" aria-label="Position in the learning path" aria-valuemin="0" aria-valuemax={learningLessons.length} aria-valuenow={index + 1}><span style={`width: ${(index + 1) / learningLessons.length * 100}%`}></span></div><strong>{String(index + 1).padStart(2, "0")} / {learningLessons.length}</strong></div>
    <nav class="lesson-step-nav" aria-label="Lesson steps"><a href="#concept-title" data-lesson-step="learn"><span>01</span> Learn</a><a href="#worked-title" data-lesson-step="example"><span>02</span> See it</a><a href="#decision-title" data-lesson-step="decide"><span>03</span> Decide</a><a href="#transfer-title" data-lesson-step="apply"><span>04</span> Apply</a></nav>
    <div class="learning-layout">
      <div class="learning-main">
        <section class="learning-block" data-step-panel="learn" aria-labelledby="concept-title">
          <p class="learning-step">01 / Learn</p><h2 id="concept-title">The idea</h2>
          {lesson.teach.map((paragraph) => <p>{paragraph}</p>)}
          <div class="learning-callout"><strong>A common mistake</strong><p>{lesson.misconception}</p></div>
          <a class="lesson-continue" href="#worked-title">See the idea in action →</a>
        </section>
        <section class="learning-block" data-step-panel="example" aria-labelledby="worked-title">
          <p class="learning-step">02 / See the reasoning</p><h2 id="worked-title">Worked example</h2>
          <p class="learning-step">Fictional scenario</p><p class="learning-context">{lesson.context}</p><p>{lesson.workedExample}</p>
          <label class="learning-complete"><input type="checkbox" data-taught-checkbox /> I reviewed the explanation and worked example.</label>
          <a class="lesson-continue" href="#decision-title">Try a decision →</a>
        </section>
        <section class="learning-block" data-step-panel="decide" aria-labelledby="decision-title">
          <p class="learning-step">03 / Decide</p><h2 id="decision-title">Guided decision</h2>
          <p>{lesson.guidedQuestion}</p>
          <form data-guided-form>
            <fieldset><legend>Choose the option you would try first</legend>
              {lesson.options.map((option, optionIndex) => <label class="learning-choice"><input type="radio" name="guided-choice" value={optionIndex} required /><span>{option.label}</span></label>)}
            </fieldset>
            <label class="learning-field" for="decision-reason">Why would you choose it? What would you verify?</label>
            <textarea id="decision-reason" name="reason" rows="4" required minlength="20" placeholder="Name the tradeoff and the evidence that could change your mind."></textarea>
            <label class="learning-field" for="decision-confidence">How confident are you under these conditions?</label>
            <select id="decision-confidence" name="confidence" required><option value="">Choose a level</option><option value="low">Low — I need key evidence</option><option value="medium">Medium — I can test this direction</option><option value="high">High — the conditions are clear</option></select>
            <button class="primary-action" type="submit">See feedback</button>
          </form>
          <div class="learning-feedback" data-feedback hidden tabindex="-1" aria-live="polite">
            <h3>Feedback on your choice</h3><p data-feedback-text></p>
            <p><strong>What could change the answer:</strong> {lesson.evidenceShift}</p>
            <p class="learning-honesty">This feedback helps you examine the decision; it does not grade your written reasoning.</p>
            <a class="lesson-continue" href="#transfer-title">Apply it somewhere new →</a>
          </div>
        </section>
        <section class="learning-block" data-step-panel="apply" aria-labelledby="transfer-title">
          <p class="learning-step">04 / Apply elsewhere</p><h2 id="transfer-title">Independent application</h2>
          <p class="learning-step">Fictional scenario</p><p class="learning-context">{lesson.transferContext}</p>
          {lesson.evidencePacket && <div class="learning-evidence"><h3>Evidence and constraints</h3><ul>{lesson.evidencePacket.map((item) => <li>{item}</li>)}</ul></div>}
          <p>{lesson.transferTask}</p>
          <p><strong>Make:</strong> {lesson.artifact}</p>
          <label class="learning-field" for="transfer-response">Draft your artifact or paste a working outline</label>
          <textarea id="transfer-response" rows="10" placeholder="Your work stays in this browser unless you copy it elsewhere."></textarea>
          <div class="learning-actions"><button type="button" data-save-artifact>Save draft</button><button type="button" data-copy-artifact>Copy draft</button></div>
          <div class="learning-callout"><strong>Review your work against {lesson.assessmentCriteria ? "these criteria" : "this criterion"}</strong><p>{lesson.assessmentFocus}</p>{lesson.assessmentCriteria && <ul>{lesson.assessmentCriteria.map((item) => <li>{item}</li>)}</ul>}</div>
          <label class="learning-complete"><input type="checkbox" data-complete-checkbox /> I completed the independent task and reviewed my artifact against {lesson.assessmentCriteria ? "the criteria" : "the criterion"}.</label>
          <p class="learning-storage-status" data-storage-status role="status"></p>
        </section>
        <section class="lesson-finish" data-lesson-finish hidden tabindex="-1" aria-live="polite">
          <span class="lesson-finish-mark" aria-hidden="true">✓</span>
          <div><p class="learning-eyebrow">{!next ? "Path complete" : endsUnit ? "Unit complete" : "Lesson complete"}</p><h2>{!next ? "Keep using what you learned." : endsUnit ? `You completed ${stage?.title.toLowerCase()}.` : "You applied the method in a new context."}</h2><p>{!next ? "You have worked through all five capabilities. Return to these methods as your work changes, and keep testing them in real settings." : endsUnit ? "You finished this unit's four independent tasks. The next unit builds on your judgment with a new capability." : "You studied the idea, tested a decision, and made an artifact for a new context. Keep the reasoning for your next UX question."}</p><div class="lesson-finish-actions">{next ? <a class="primary-action" href={withBase(`/learn/${next.id}/`)}>Next lesson: {next.title} →</a> : <a class="primary-action" href={withBase("/practice/")}>Continue with independent practice →</a>}<a href={withBase("/learn/")}>See the whole path</a></div></div>
        </section>
        <section class="learning-block" aria-labelledby="references-title">
          <p class="learning-step">05 / Keep working</p><h2 id="references-title">Sources and related patterns</h2>
          <ul class="learning-link-list">{lesson.sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a></li>)}</ul>
          <div class="learning-patterns">{lesson.patternIds.map((id) => <a href={withBase(`/patterns/${id}/`)}>{id.replaceAll("-", " ")}</a>)}</div>
          <p><a href={withBase(`/work/${relatedWorkflow.id}/`)}>Apply this skill: {relatedWorkflow.title} →</a></p>
        </section>
        <nav class="learning-next" aria-label="Lesson navigation">
          {previous && <a href={withBase(`/learn/${previous.id}/`)}>← {previous.title}</a>}
          {next ? <a href={withBase(`/learn/${next.id}/`)}>Next: {next.title} →</a> : <a href={withBase("/practice/")}>Explore practice →</a>}
        </nav>
      </div>
      <aside class="learning-side lesson-side" aria-label="Learning path"><p class="learning-eyebrow">Your unit</p><h2>{stage?.title}</h2><ol>{learningLessons.filter((item) => item.stage === lesson.stage).map((item) => <li><a href={withBase(`/learn/${item.id}/`)} aria-current={item.id === lesson.id ? "page" : undefined}>{item.title}</a></li>)}</ol><a href={withBase("/learn/")}>See all 20 lessons →</a></aside>
    </div>
  </article>
  <script>
    import { learningStorageAvailable, readLearningProgress, saveLessonProgress } from "@/lib/learning-progress";
    import { track } from "@/lib/analytics";
    const root = document.querySelector<HTMLElement>("[data-lesson-id]");
    if (root) {
      const id = root.dataset.lessonId || "";
      const form = root.querySelector<HTMLFormElement>("[data-guided-form]");
      const feedback = root.querySelector<HTMLElement>("[data-feedback]");
      const feedbackText = root.querySelector<HTMLElement>("[data-feedback-text]");
      const reason = root.querySelector<HTMLTextAreaElement>("#decision-reason");
      const confidence = root.querySelector<HTMLSelectElement>("#decision-confidence");
      const artifact = root.querySelector<HTMLTextAreaElement>("#transfer-response");
      const taught = root.querySelector<HTMLInputElement>("[data-taught-checkbox]");
      const complete = root.querySelector<HTMLInputElement>("[data-complete-checkbox]");
      const status = root.querySelector<HTMLElement>("[data-storage-status]");
      const lessonStatus = root.querySelector<HTMLElement>("[data-lesson-status]");
      const finish = root.querySelector<HTMLElement>("[data-lesson-finish]");
      const stepNames = ["learn", "example", "decide", "apply"];
      const panels = stepNames.map((name) => root.querySelector<HTMLElement>(`[data-step-panel="${name}"]`));
      function panelForHash(hash: string) {
        const target = hash ? document.getElementById(hash.slice(1)) : null;
        if (target?.id === "references-title") return panels[3];
        return target && root?.contains(target) ? target.closest<HTMLElement>("[data-step-panel]") : null;
      }
      function showStep(name: string, focus = false) {
        const targetIndex = stepNames.indexOf(name);
        if (targetIndex < 0) return;
        root?.setAttribute("data-interactive", "true");
        panels.forEach((panel, panelIndex) => { if (panel) panel.dataset.active = panelIndex === targetIndex ? "true" : "false"; });
        root?.querySelectorAll<HTMLAnchorElement>("[data-lesson-step]").forEach((link, linkIndex) => {
          if (linkIndex === targetIndex) link.setAttribute("aria-current", "step");
          else link.removeAttribute("aria-current");
        });
        if (focus) {
          const heading = panels[targetIndex]?.querySelector<HTMLElement>("h2");
          if (heading) { heading.tabIndex = -1; heading.focus(); }
        }
      }
      function updateSteps() {
        const states = [Boolean(taught?.checked), Boolean(taught?.checked), Boolean(feedback && !feedback.hidden), Boolean(complete?.checked)];
        root?.querySelectorAll<HTMLElement>("[data-lesson-step]").forEach((step, stepIndex) => {
          step.dataset.status = states[stepIndex] ? "done" : stepIndex === 0 || states[stepIndex - 1] ? "current" : "upcoming";
        });
        if (finish) finish.hidden = !complete?.checked;
        if (lessonStatus && complete?.checked) lessonStatus.textContent = "Independent task completed";
      }
      if (!learningStorageAvailable()) {
        const storageNote = root.querySelector<HTMLElement>(".learning-progress-card span");
        if (storageNote) storageNote.textContent = "Browser storage is unavailable. You can continue and copy your work, but progress will not persist.";
        if (status) status.textContent = "Browser storage is unavailable. Copy your artifact to keep it.";
      }
      const feedbacks: string[] = JSON.parse(root.dataset.feedbacks || "[]");
      const initial = readLearningProgress()[id];
      if (initial) {
        if (taught) taught.checked = Boolean(initial.taught);
        if (initial.choice !== undefined) {
          const choice = form?.querySelector<HTMLInputElement>(`input[value="${initial.choice}"]`);
          if (choice) choice.checked = true;
          if (feedback && feedbackText) { feedbackText.textContent = feedbacks[initial.choice] || ""; feedback.hidden = false; }
          lessonStatus && (lessonStatus.textContent = initial.completed ? "Independent task completed" : "Decision practiced");
        }
        else if (initial.taught && lessonStatus) lessonStatus.textContent = "Teaching reviewed";
        if (reason) reason.value = initial.reason || "";
        if (confidence) confidence.value = initial.confidence || "";
        if (artifact) artifact.value = initial.artifact || "";
        if (complete) complete.checked = Boolean(initial.completed);
        track("learning_resumed", { lessonId: id });
      }
      const stepFromHash = panelForHash(location.hash)?.dataset.stepPanel;
      const returnStep = initial?.completed || initial?.choice !== undefined ? "apply" : initial?.taught ? "decide" : "learn";
      showStep(stepFromHash || returnStep);
      root.querySelectorAll<HTMLAnchorElement>('.lesson-step-nav a, .lesson-continue').forEach((link) => link.addEventListener("click", (event) => {
        const step = panelForHash(link.hash)?.dataset.stepPanel;
        if (!step) return;
        event.preventDefault();
        history.replaceState(null, "", link.hash);
        showStep(step, true);
      }));
      window.addEventListener("hashchange", () => {
        const step = panelForHash(location.hash)?.dataset.stepPanel;
        if (step) showStep(step, true);
      });
      updateSteps();
      function reopenCompletedTask() {
        if (!complete?.checked) return;
        complete.checked = false;
        const saved = saveLessonProgress(id, { completed: false });
        if (lessonStatus) lessonStatus.textContent = "Independent task in progress";
        if (status) status.textContent = saved ? "Your changes reopened this task. Review and mark it complete again when ready." : "Your changes reopened this task, but progress could not be saved. Copy your work to keep it.";
        updateSteps();
      }
      artifact?.addEventListener("input", reopenCompletedTask);
      reason?.addEventListener("input", reopenCompletedTask);
      confidence?.addEventListener("change", reopenCompletedTask);
      form?.querySelectorAll<HTMLInputElement>('input[name="guided-choice"]').forEach((choice) => choice.addEventListener("change", () => {
        reopenCompletedTask();
        if (feedback) feedback.hidden = true;
        if (lessonStatus) lessonStatus.textContent = "Decision in progress";
        updateSteps();
      }));
      taught?.addEventListener("change", () => {
        const saved = saveLessonProgress(id, { taught: taught.checked, ...(!taught.checked ? { completed: false } : {}) });
        if (!taught.checked && complete) complete.checked = false;
        if (lessonStatus) lessonStatus.textContent = taught.checked ? "Teaching reviewed" : "Teaching not reviewed";
        if (!saved && status) status.textContent = "Progress could not be saved on this device. You can still continue and copy your work.";
        if (taught.checked) track("lesson_teaching_reviewed", { lessonId: id });
        updateSteps();
      });
      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const choice = Number(new FormData(form).get("guided-choice"));
        if (feedbackText) feedbackText.textContent = feedbacks[choice] || "";
        if (feedback) { feedback.hidden = false; feedback.focus(); }
        if (lessonStatus) lessonStatus.textContent = "Decision practiced";
        const saved = saveLessonProgress(id, { choice, reason: reason?.value || "", confidence: confidence?.value || "" });
        if (!saved && status) status.textContent = "Progress could not be saved on this device. You can still continue and copy your work.";
        track("guided_decision_completed", { lessonId: id, option: String(choice) });
        updateSteps();
      });
      root.querySelector("[data-save-artifact]")?.addEventListener("click", () => {
        if (!artifact) return;
        const saved = saveLessonProgress(id, { artifact: artifact.value });
        if (status) status.textContent = saved ? "Draft saved in this browser." : "Could not save on this device. Copy your draft to keep it.";
        if (saved) track("learning_artifact_saved", { lessonId: id });
      });
      root.querySelector("[data-copy-artifact]")?.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(artifact?.value || ""); if (status) status.textContent = "Draft copied."; }
        catch { if (status) status.textContent = "Copy was unavailable. Select the text above to copy it."; }
      });
      complete?.addEventListener("change", () => {
        if (!complete.checked) { saveLessonProgress(id, { completed: false }); if (lessonStatus) lessonStatus.textContent = "Independent task in progress"; updateSteps(); return; }
        if (!taught?.checked || !feedback || feedback.hidden || !artifact?.value.trim()) {
          complete.checked = false;
          if (status) status.textContent = "Review the teaching, complete the guided decision, and write your independent artifact first.";
          return;
        }
        const saved = saveLessonProgress(id, { artifact: artifact.value, completed: true });
        if (lessonStatus) lessonStatus.textContent = "Independent task completed";
        if (status) status.textContent = saved ? "Completion saved in this browser." : "Completion could not be saved on this device. Copy your work to keep it.";
        track("lesson_completed", { lessonId: id });
        updateSteps();
        finish?.focus();
      });
      track("lesson_opened", { lessonId: id });
    }
  </script>
</BaseLayout>
