---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { learningLessons, learningStages } from "@/data/learning";
import { withBase } from "@/lib/paths";
import { pageTitle } from "@/lib/seo";
---

<BaseLayout title={pageTitle("Practice UX judgment")} description="Build a connected clinic case file, then transfer the method to an independent library capstone.">
  <div class="learning-page"><header class="learning-hero"><div><p class="learning-eyebrow">Practice</p><h1>Build your case file, one decision at a time.</h1><p class="learning-lead">The first nineteen exercises develop the same fictional clinic case. Each adds an artifact you can review against specific criteria. The final case applies the complete method to a library service.</p></div></header>
    <div class="practice-filters"><label for="practice-skill">Skill</label><select id="practice-skill"><option value="all">All skills</option>{learningStages.map((stage) => <option value={stage.id}>{stage.title}</option>)}</select><p>Open a case to use the evidence packet, make the requested artifact, and review your reasoning.</p></div>
    <p class="practice-count" data-practice-count role="status">{learningLessons.length} cases</p>
    <div class="practice-grid">{learningLessons.map((lesson) => <article class="practice-card" data-practice-stage={lesson.stage} data-practice-card-id={lesson.id}><span>{learningStages.find((stage) => stage.id === lesson.stage)?.title} · {lesson.id === "capstone-ux-decision" ? "Library capstone" : "Clinic case"}</span><h2><a href={withBase(`/practice/${lesson.id}/`)}>{lesson.title}</a></h2><p><strong>Situation:</strong> {lesson.transferContext}</p><p><strong>Make:</strong> {lesson.artifact}</p><small>{lesson.assessmentFocus}</small><p class="practice-card-status" data-practice-card-status></p></article>)}</div>
  </div>
  <script>
    import { track } from "@/lib/analytics";
    const skill = document.querySelector<HTMLSelectElement>("#practice-skill");
    document.querySelectorAll<HTMLElement>("[data-practice-card-id]").forEach((card) => {
      try {
        const entry = JSON.parse(localStorage.getItem(`uxpg:practice:v1:${card.dataset.practiceCardId}`) || "{}");
        const status = card.querySelector<HTMLElement>("[data-practice-card-status]");
        if (status) status.textContent = entry.reviewed ? "Reviewed attempt saved" : entry.artifact ? "Draft saved" : "";
      } catch { /* Storage is optional. */ }
    });
    function filter() {
      let visible = 0;
      document.querySelectorAll<HTMLElement>("[data-practice-stage]").forEach((card) => { card.hidden = skill?.value !== "all" && card.dataset.practiceStage !== skill?.value; if (!card.hidden) visible++; });
      const count = document.querySelector<HTMLElement>("[data-practice-count]"); if (count) count.textContent = `${visible} ${visible === 1 ? "case" : "cases"}`;
      track("practice_filtered", { skill: skill?.value || "all" });
    }
    skill?.addEventListener("change", filter);
  </script>
</BaseLayout>
