---
import CatalogWorkbenchLoader from "@/components/CatalogWorkbenchLoader";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/paths";
import { breadcrumbJsonLd, collectionPageJsonLd, pageTitle } from "@/lib/seo";

const siteUrl = Astro.site ?? new URL("https://uxpatternsguide.com");
const description = "Use the interactive UX pattern lab to filter source-backed patterns by product problem, platform, risk, and implementation state.";
---

<BaseLayout
  title={pageTitle("UX Pattern Lab")}
  description={description}
  structuredData={[
    collectionPageJsonLd("UX Pattern Lab", description, "/lab/", siteUrl),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Pattern Lab", path: "/lab/" }
    ], siteUrl)
  ]}
>
  <nav class="breadcrumb-trail" aria-label="Breadcrumb">
    <a href={withBase("/")}>Home</a>
    <span aria-current="page">Pattern Lab</span>
  </nav>

  <header class="pattern-directory-hero lab-page-head">
    <div>
      <div class="pattern-kicker">
        <span>Interactive catalog</span>
        <span>State inspection</span>
        <span>Decision support</span>
      </div>
      <h1>UX Pattern Lab</h1>
      <p>{description}</p>
      <div class="pattern-hero-actions">
        <a class="primary-action" href={withBase("/patterns/")}>Browse directory</a>
        <a class="secondary-action" href={withBase("/compare/")}>Compare patterns</a>
      </div>
    </div>
    <aside class="source-method-panel">
      <h2>What to inspect</h2>
      <p>Use the lab to explore required states, keyboard behavior, live examples, failure modes, and alternatives through direct interaction.</p>
    </aside>
  </header>

  <section class="catalog-section catalog-reading-guide" aria-labelledby="lab-method-title"><div class="section-heading"><span>Practice in the lab</span><h2 id="lab-method-title">Use the example to test a prediction</h2><p>Choose a pattern and name the task it should support. Compare strong and weak states, then trigger an error or interruption and follow the recovery route.</p></div><ol><li><strong>Predict.</strong> Write what the person expects after the first action.</li><li><strong>Operate.</strong> Try pointer and keyboard paths through the example.</li><li><strong>Compare.</strong> Switch between strong and weak UI and UX states; identify the changed cue and consequence.</li><li><strong>Transfer.</strong> Record the state and recovery behavior your own product would need.</li></ol></section>

  <CatalogWorkbenchLoader
    client:load
    dataUrl={withBase("/lab-data.json")}
    baseUrl={withBase("/")}
    detailBaseUrl={withBase("/lab-patterns/")}
  />
</BaseLayout>
