---
import CatalogWorkbenchLoader from "@/components/CatalogWorkbenchLoader";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/paths";
import { breadcrumbJsonLd, collectionPageJsonLd, pageTitle } from "@/lib/seo";

const siteUrl = Astro.site ?? new URL("https://uxpatternsguide.com");
const description = "Use the interactive UX pattern lab to filter source-backed patterns by product problem, platform, risk, and implementation state.";
---

<BaseLayout
  title={pageTitle("UX Pattern Lab")}
  description={description}
  structuredData={[
    collectionPageJsonLd("UX Pattern Lab", description, "/lab/", siteUrl),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Pattern Lab", path: "/lab/" }
    ], siteUrl)
  ]}
>
  <nav class="breadcrumb-trail" aria-label="Breadcrumb">
    <a href={withBase("/")}>Home</a>
    <span aria-current="page">Pattern Lab</span>
  </nav>

  <header class="pattern-directory-hero lab-page-head">
    <div>
      <h1>UX Pattern Lab</h1>
      <p>Try strong and weak versions of the same interaction.</p>
    </div>
  </header>

  <CatalogWorkbenchLoader
    client:load
    dataUrl={withBase("/lab-data.json")}
    baseUrl={withBase("/")}
    detailBaseUrl={withBase("/lab-patterns/")}
  />

  <details class="catalog-section catalog-reading-guide lab-reading-guide">
    <summary>How to learn from an example</summary>
    <ol><li><strong>Predict.</strong> Name what you expect after the first action.</li><li><strong>Operate.</strong> Try pointer and keyboard paths through the example.</li><li><strong>Compare.</strong> Inspect strong and weak states and their consequences.</li><li><strong>Transfer.</strong> Record the state and recovery behavior your own product needs.</li></ol>
    <p><a href={withBase("/patterns/")}>Browse the pattern directory</a> · <a href={withBase("/compare/")}>Compare alternatives</a></p>
  </details>
</BaseLayout>
