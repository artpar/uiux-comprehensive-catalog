---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPatternsForSource, sources } from "@/lib/catalog";
import { withBase } from "@/lib/paths";
import { absoluteUrl, breadcrumbJsonLd, pageTitle, SITE_NAME } from "@/lib/seo";

export function getStaticPaths() {
  return sources.map((source) => ({
    params: { id: source.id },
    props: { source }
  }));
}

const { source } = Astro.props;
const evidenceRole: Record<string, string> = {
  spec: "Use this source to check a technical or accessibility requirement against its exact wording and scope.",
  "platform-guideline": "Use this source to understand a platform convention and the setting it was designed for.",
  "ux-research": "Use this source to examine the study question, participants, observations, and limits before applying a finding.",
  "service-manual": "Use this source to study a complete public-service task and the guidance that supports its implementation.",
  "product-example": "Use this source to inspect a concrete implementation and the decisions visible in its context.",
  "hci-literature": "Use this source to trace a research claim to its method and evidence.",
  "pattern-library": "Use this source to compare a documented solution with the task and states in your own product."
};
const linkedPatterns = getPatternsForSource(source.id);
const claimRows = linkedPatterns.map((pattern) => ({
  pattern,
  note: pattern.sources.find((ref) => ref.id === source.id)?.note ?? source.notes
}));
const siteUrl = Astro.site ?? new URL("https://uxpatternsguide.com");
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: `${source.name} UX Pattern Source`,
    description: source.notes,
    url: absoluteUrl(`/sources/${source.id}/`, siteUrl),
    dateModified: source.checkedAt,
    inLanguage: "en",
    about: linkedPatterns.map((pattern) => pattern.name),
    sameAs: source.url,
    isPartOf: {
      "@type": "WebSite",
      name: SITE_NAME,
      url: absoluteUrl("/", siteUrl)
    },
    publisher: {
      "@type": "Organization",
      name: SITE_NAME,
      url: absoluteUrl("/", siteUrl)
    }
  },
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Sources", path: "/sources/" },
    { name: source.name, path: `/sources/${source.id}/` }
  ], siteUrl)
];
---

<BaseLayout title={pageTitle(`${source.name} UX Pattern Source`)} description={source.notes} structuredData={structuredData}>
  <nav class="breadcrumb-trail" aria-label="Breadcrumb">
    <a href={withBase("/")}>Home</a>
    <a href={withBase("/sources/")}>Sources</a>
    <span aria-current="page">{source.name}</span>
  </nav>

  <section class="pattern-decision-hero source-detail-hero">
    <div class="pattern-hero-main">
      <div class="pattern-kicker">
        <span>{source.type}</span>
        <span>{linkedPatterns.length} linked patterns</span>
        <span>checked <time datetime={source.checkedAt}>{source.checkedAt}</time></span>
      </div>
      <h1>{source.name}</h1>
      <p class="pattern-definition">{source.notes}</p>
      <div class="pattern-hero-actions">
        <a
          class="primary-action"
          href={source.url}
          data-analytics-event="external_source_opened"
          data-source-id={source.id}
          data-source-type={source.type}
          data-surface="source_detail"
        >Open source</a>
        <a class="secondary-action" href={withBase("/sources/")}>All sources</a>
      </div>
    </div>
    <aside class="pattern-trust-panel">
      <dl>
        <div><dt>Evidence type</dt><dd>{source.type}</dd></div>
        <div><dt>Publisher</dt><dd>{source.publisher ?? "Unknown"}</dd></div>
        <div><dt>Pattern claims</dt><dd>{linkedPatterns.length}</dd></div>
        <div><dt>Checked</dt><dd><time datetime={source.checkedAt}>{source.checkedAt}</time></dd></div>
      </dl>
    </aside>
  </section>

  <section class="catalog-section catalog-reading-guide" aria-labelledby="read-source-title"><div class="section-heading"><span>Read with a purpose</span><h2 id="read-source-title">What this source can teach</h2><p>{evidenceRole[source.type]}</p></div><ol><li><strong>Start with the original.</strong> Open the source and find the guidance or example relevant to your task.</li><li><strong>Trace the connection.</strong> Use the claim notes below to see how this site applies the source to specific patterns.</li><li><strong>Check the setting.</strong> Compare the source's platform, people, and constraints with your own decision.</li></ol></section>

  <section class="comparison-matrix detail-panel">
    <h2>Pattern Decisions This Source Supports</h2>
    {linkedPatterns.length > 0 ? (
      <table>
        <thead>
          <tr>
            <th>Pattern</th>
            <th>Supported decision</th>
            <th>Required contract</th>
            <th>Claim note</th>
          </tr>
        </thead>
        <tbody>
          {claimRows.map(({ pattern, note }) => (
            <tr>
              <td><a href={withBase(`/patterns/${pattern.id}/`)}>{pattern.name}</a></td>
              <td>{pattern.selectionRules[0]}</td>
              <td>{pattern.interactionContract[0]}</td>
              <td>{note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p>This source is ready for a future pattern connection.</p>
    )}
  </section>

  <section class="detail-panel">
    <h2>Evidence Role</h2>
    <p>This source is treated as <strong>{source.type}</strong> evidence. Its value comes from the specific claims and setting described above.</p>
    <p>Publisher: {source.publisher ?? "Unknown"}. Last checked: <time datetime={source.checkedAt}>{source.checkedAt}</time>.</p>
  </section>
</BaseLayout>
