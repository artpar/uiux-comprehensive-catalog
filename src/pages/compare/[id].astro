---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EngagementActions from "@/components/EngagementActions.astro";
import { comparisons, getPattern, getSource } from "@/lib/catalog";
import { withBase } from "@/lib/paths";
import { affirmative } from "@/lib/lesson-copy";
import { absoluteUrl, breadcrumbJsonLd, pageTitle, SITE_NAME } from "@/lib/seo";
import type { PatternEntry } from "@/schemas/catalog";
import { principleForCategory, uiPrinciples } from "@/data/ui-principles";

function isPattern(value: PatternEntry | undefined): value is PatternEntry {
  return Boolean(value);
}

function formatPatternType(value: PatternEntry["patternType"]) {
  if (value === "ui") return "UI";
  if (value === "ux") return "UX";
  return "UI + UX";
}

export function getStaticPaths() {
  return comparisons.map((comparison) => ({
    params: { id: comparison.id },
    props: { comparison }
  }));
}

const { comparison } = Astro.props;
const comparedPatterns = comparison.patternIds.map((id) => getPattern(id)).filter(isPattern);
const relatedPrinciple = uiPrinciples.find((item) => item.id === principleForCategory[comparedPatterns[0]?.category]);
const comparisonLead = affirmative([comparison.summary, ...comparison.decisionRules], `Choose the interaction that supports the person's task and its outcome.`);
const practiceCase = affirmative(comparison.failureModes, `A person reaches a result and needs a clear route to continue.`);
const sourceRefs = comparison.sources.map((ref) => ({ ref, source: getSource(ref.id) }));
const siteUrl = Astro.site ?? new URL("https://uxpatternsguide.com");
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: `${comparison.title} UX Pattern Comparison`,
    name: comparison.title,
    description: comparison.summary,
    url: absoluteUrl(`/compare/${comparison.id}/`, siteUrl),
    dateModified: comparison.lastVerified,
    inLanguage: "en",
    about: comparedPatterns.map((pattern) => pattern.name),
    citation: sourceRefs.map(({ source }) => source?.url).filter(Boolean),
    isPartOf: {
      "@type": "WebSite",
      name: SITE_NAME,
      url: absoluteUrl("/", siteUrl)
    },
    publisher: {
      "@type": "Organization",
      name: SITE_NAME,
      url: absoluteUrl("/", siteUrl)
    }
  },
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Comparisons", path: "/compare/" },
    { name: comparison.title, path: `/compare/${comparison.id}/` }
  ], siteUrl)
];
const dimensions = [
  {
    label: "UI or UX",
    value: (pattern: PatternEntry) => `${formatPatternType(pattern.patternType)} - ${pattern.surfaceType}`
  },
  {
    label: "UI guidance",
    value: (pattern: PatternEntry) => affirmative(pattern.uiGuidance, "Give each control a clear label and visible state.")
  },
  {
    label: "UX guidance",
    value: (pattern: PatternEntry) => affirmative(pattern.uxGuidance, "Help the person reach a clear task outcome.")
  },
  {
    label: "Good UI",
    value: (pattern: PatternEntry) => affirmative(pattern.uiExamples.good, "The interface shows a clear action and state.")
  },
  {
    label: "Bad UI",
    value: (pattern: PatternEntry) => affirmative([...pattern.uiExamples.bad, ...pattern.failureModes], "The visual cue leaves the next action unclear.")
  },
  {
    label: "Good UX",
    value: (pattern: PatternEntry) => affirmative(pattern.uxExamples.good, "The person reaches the intended result with clear feedback.")
  },
  {
    label: "Bad UX",
    value: (pattern: PatternEntry) => affirmative([...pattern.uxExamples.bad, ...pattern.failureModes], "The person spends extra work resolving the result.")
  },
  {
    label: "Best fit",
    value: (pattern: PatternEntry) => affirmative([...pattern.useWhen, ...pattern.selectionRules], "Choose this pattern when it supports the person's task.")
  },
  {
    label: "Avoid when",
    value: (pattern: PatternEntry) => affirmative(pattern.avoidWhen, "Choose another interaction when the task calls for a different route.")
  },
  {
    label: "Required state",
    value: (pattern: PatternEntry) => affirmative(pattern.requiredStates, "Show the current state and next action.")
  },
  {
    label: "Accessibility burden",
    value: (pattern: PatternEntry) => affirmative([...pattern.accessibility, ...pattern.keyboardBehavior], "Verify focus, labels, and operable controls.")
  },
  {
    label: "Common misuse",
    value: (pattern: PatternEntry) => affirmative([...pattern.commonMisuses, ...pattern.failureModes], "The interface creates extra interpretation or recovery work.")
  }
];
---

<BaseLayout title={pageTitle(`${comparison.title} UX Pattern Comparison`)} description={comparison.summary} structuredData={structuredData}>
  <nav class="breadcrumb-trail" aria-label="Breadcrumb">
    <a href={withBase("/")}>Home</a>
    <a href={withBase("/compare/")}>Comparisons</a>
    <span aria-current="page">{comparison.title}</span>
  </nav>

  <section class="compare-detail-head">
    <a class="open-link" href={withBase("/compare/")}>Back to compare picker</a>
    <h1>{comparedPatterns.map((pattern) => pattern.name).join(" vs ")}</h1>
    <p>{comparisonLead}</p>
    <div class="comparison-links">
      {comparedPatterns.map((pattern) => (
        <a data-live-pattern={pattern.id} href={withBase(`/lab/?pattern=${pattern.id}`)}>{pattern.name} live example</a>
      ))}
    </div>
    <EngagementActions id={comparison.id} title={comparison.title} summary={comparisonLead} kind="comparison" />
  </section>

  <section class="comparison-study" aria-labelledby="comparison-study-title">
    <div class="section-heading"><span>Learn the decision</span><h2 id="comparison-study-title">Match the interaction to the person's task</h2><p>{comparisonLead}</p></div>
    <div class="comparison-study-options">{comparedPatterns.map((pattern) => <article><h3>{pattern.name}</h3><p><strong>Use it when:</strong> {affirmative(pattern.useWhen, `The task calls for ${pattern.name.toLowerCase()}.`)}</p><p><strong>Make this state clear:</strong> {affirmative(pattern.requiredStates, `Show the current state and next action.`)}</p><p><strong>Observe the result:</strong> {affirmative(pattern.uxExamples.good, `The person reaches a clear outcome.`)}</p><a href={withBase(`/patterns/${pattern.id}/`)}>Study the full pattern →</a></article>)}</div>
    <div class="comparison-study-prompt"><p><strong>Practice the judgment:</strong> Imagine this situation: {practiceCase} Write the person's goal, choose one of these patterns, and show the state that helps the person continue. Use the decision rules and source trail below to explain your choice.</p>{relatedPrinciple && <a href={withBase(`/principles/${relatedPrinciple.id}/`)}>Review the underlying principle →</a>}</div>
  </section>

  <section class="detail-panel context-panel" id="workbench-context" hidden>
    <h2>Workbench Context</h2>
    <dl class="context-list">
      <div><dt>Selected</dt><dd data-context-value="selected"></dd></div>
      <div><dt>Shortlist</dt><dd data-context-value="shortlist"></dd></div>
      <div><dt>User job</dt><dd data-context-value="job"></dd></div>
      <div><dt>Search</dt><dd data-context-value="query"></dd></div>
      <div><dt>Mode</dt><dd data-context-value="mode"></dd></div>
      <div><dt>Category</dt><dd data-context-value="category"></dd></div>
      <div><dt>Platform</dt><dd data-context-value="platform"></dd></div>
      <div><dt>Maturity</dt><dd data-context-value="maturity"></dd></div>
      <div><dt>Risk</dt><dd data-context-value="risk"></dd></div>
      <div><dt>Recovery</dt><dd data-context-value="recovery"></dd></div>
      <div><dt>Urgency</dt><dd data-context-value="urgency"></dd></div>
      <div><dt>Confidence</dt><dd data-context-value="confidence"></dd></div>
      <div><dt>Interruption</dt><dd data-context-value="interruption"></dd></div>
    </dl>
  </section>

  <section class="comparison-matrix detail-panel compare-decision-table">
    <h2>Decision dimensions</h2>
    <table>
      <thead>
        <tr>
          <th>Dimension</th>
          {comparedPatterns.map((pattern) => <th>{pattern.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {dimensions.map((dimension) => (
          <tr>
            <th scope="row">{dimension.label}</th>
            {comparedPatterns.map((pattern) => <td>{dimension.value(pattern)}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
    <div class="compare-mobile-cards" aria-label="Decision dimensions by pattern">
      {comparedPatterns.map((pattern) => (
        <article>
          <h3>{pattern.name}</h3>
          <dl>
            {dimensions.map((dimension) => (
              <div>
                <dt>{dimension.label}</dt>
                <dd>{dimension.value(pattern)}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </section>

  <div class="detail-grid">
    <div class="stack">
      <details class="detail-panel compact-disclosure">
        <summary>Decision rules</summary>
        <ul>
          {comparison.decisionRules.map((item) => <li>{item}</li>)}
        </ul>
      </details>

      <details class="detail-panel compact-disclosure">
        <summary>Inspect live examples</summary>
        <div class="comparison-links">
          {comparedPatterns.map((pattern) => (
            <a data-live-pattern={pattern.id} href={withBase(`/lab/?pattern=${pattern.id}`)}>{pattern.name}</a>
          ))}
        </div>
      </details>

      {comparison.failureModes.length > 0 && (
        <details class="detail-panel compact-disclosure">
          <summary>Failure modes</summary>
          <ul>
            {comparison.failureModes.map((item) => <li>{item}</li>)}
          </ul>
        </details>
      )}
    </div>

    <aside class="stack">
      <details class="detail-panel compact-disclosure">
        <summary>Sources</summary>
        <ul>
          {sourceRefs.map(({ ref, source }) => (
            <li>
              {source ? <a href={withBase(`/sources/${source.id}/`)}>{source.name}</a> : ref.id}
              <br />
              <span>{ref.note}</span>
            </li>
          ))}
        </ul>
      </details>

      <section class="detail-panel compact-note">
        <h2>Verification</h2>
        <p>Source trail checked: <time datetime={comparison.lastVerified}>{comparison.lastVerified}</time></p>
      </section>
    </aside>
  </div>

  <script>
    const contextPanel = document.getElementById("workbench-context");
    const params = new URLSearchParams(window.location.search);
    const contextKeys = [
      "selected",
      "shortlist",
      "job",
      "query",
      "mode",
      "category",
      "platform",
      "maturity",
      "risk",
      "recovery",
      "urgency",
      "confidence",
      "interruption"
    ];
    const hasContext = contextKeys.some((key) => params.has(key));

    if (contextPanel && hasContext) {
      contextPanel.hidden = false;
      contextKeys.forEach((key) => {
        const target = contextPanel.querySelector(`[data-context-value="${key}"]`);
        if (!target) return;
        target.textContent = params.get(key)?.replaceAll(",", ", ") || "Add detail";
      });
    }

    document.querySelectorAll("[data-live-pattern]").forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const pattern = link.getAttribute("data-live-pattern");
      const nextParams = new URLSearchParams(window.location.search);
      nextParams.delete("selected");
      if (pattern) nextParams.set("pattern", pattern);
      link.href = `${link.pathname}${nextParams.toString() ? `?${nextParams.toString()}` : ""}`;
    });
  </script>
</BaseLayout>
