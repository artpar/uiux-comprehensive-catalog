---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { comparisons, patterns, getPattern } from "@/lib/catalog";
import { withBase } from "@/lib/paths";
import { breadcrumbJsonLd, collectionPageJsonLd, pageTitle } from "@/lib/seo";
import { patternCategories } from "@/schemas/catalog";

const patternOptions = patterns
  .filter((pattern) => pattern.maturity !== "anti-pattern")
  .map((pattern) => ({ id: pattern.id, name: pattern.name }))
  .sort((a, b) => a.name.localeCompare(b.name));
const comparisonOptions = comparisons.map((comparison) => {
  const comparedPatterns = comparison.patternIds.map((id) => getPattern(id)).filter(Boolean);
  const categories = [
    ...new Set(
      comparedPatterns
        .flatMap((pattern) => [pattern?.category, ...(pattern?.secondaryCategories ?? [])])
        .filter(Boolean)
    )
  ];
  return {
    id: comparison.id,
    title: comparison.title,
    href: withBase(`/compare/${comparison.id}/`),
    patternIds: comparison.patternIds,
    patternNames: comparedPatterns.map((pattern) => pattern?.name ?? "").filter(Boolean),
    categories,
    primaryCategory: categories[0] ?? "Other",
    summary: comparison.summary,
    rule: comparison.decisionRules[0],
    lastVerified: comparison.lastVerified
  };
});
const categoryFilters = patternCategories
  .map((category) => ({
    category,
    count: comparisonOptions.filter((comparison) => comparison.primaryCategory === category).length
  }))
  .filter((item) => item.count > 0);
const initialComparisons = comparisonOptions.slice(0, 24);
const initialComparisonGroups = [...initialComparisons.reduce((groups, comparison) => {
  const items = groups.get(comparison.primaryCategory) ?? [];
  items.push(comparison);
  groups.set(comparison.primaryCategory, items);
  return groups;
}, new Map<string, typeof comparisonOptions>())];
const siteUrl = Astro.site ?? new URL("https://uxpatternsguide.com");
const description = "Compare UX and UI patterns side by side before choosing an interaction model for a product workflow.";
---

<BaseLayout
  title={pageTitle("UX Pattern Comparisons")}
  description={description}
  structuredData={[
    collectionPageJsonLd("UX Pattern Comparisons", description, "/compare/", siteUrl),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Comparisons", path: "/compare/" }
    ], siteUrl)
  ]}
>
  <div class="compare-home">
    <nav class="breadcrumb-trail" aria-label="Breadcrumb">
      <a href={withBase("/")}>Home</a>
      <span aria-current="page">Comparisons</span>
    </nav>

    <section class="compare-hero" aria-labelledby="compare-title">
      <div class="compare-intro">
        <div class="pattern-kicker">
          <span>{comparisonOptions.length} comparisons</span>
          <span>{categoryFilters.length} families</span>
          <span>Decision rules</span>
        </div>
        <h1 id="compare-title">Choose the right pattern before you build</h1>
        <p>{description}</p>
        <div class="decision-track-grid compare-principles">
          <span><strong>Compare fit</strong> Similar-looking UI can carry different task costs.</span>
          <span><strong>Check failure</strong> Every comparison names misuse and avoid-when conditions.</span>
          <span><strong>Open lab</strong> Inspect states before committing to a pattern.</span>
        </div>
      </div>

      <form class="compare-form" data-compare-form>
        <h2>Find a supported pair</h2>
        <label>
          <span>First pattern</span>
          <select name="first">
            <option value="">Choose pattern</option>
            {patternOptions.map((pattern) => <option value={pattern.id}>{pattern.name}</option>)}
          </select>
        </label>

        <label>
          <span>Second pattern</span>
          <select name="second">
            <option value="">Choose pattern</option>
            {patternOptions.map((pattern) => <option value={pattern.id}>{pattern.name}</option>)}
          </select>
        </label>

        <button class="demo-button primary compare-open" data-compare-open type="button" disabled>
          Open comparison
        </button>
        <p class="demo-status" data-compare-status role="status" aria-live="polite">Choose a supported pair to compare.</p>
      </form>
    </section>

    <section class="compare-browse" aria-labelledby="available-comparisons">
      <div class="compare-browse-head">
        <div class="section-heading">
          <span>{comparisonOptions.length} comparisons</span>
          <h2 id="available-comparisons">Browse by product decision</h2>
          <p>Use search when you know the pattern name; use categories when you know the workflow area.</p>
        </div>
        <label class="compare-search">
          <span>Search comparisons</span>
          <input data-compare-search type="search" placeholder="Search by pattern, category, or decision rule" />
        </label>
      </div>

      <label class="compare-category-select">
        <span>Category</span>
        <select data-compare-category-select>
          <option value="all">All categories ({comparisonOptions.length})</option>
          {categoryFilters.map((item) => <option value={item.category}>{item.category} ({item.count})</option>)}
        </select>
      </label>

      <p class="compare-result-count" data-compare-result-count>{comparisonOptions.length} comparisons shown</p>
      <p class="compare-empty" data-compare-empty hidden>No comparisons match this filter.</p>

      <div class="comparison-library" data-comparison-library>
        {initialComparisonGroups.map(([category, items]) => (
          <section class="comparison-category-section">
            <div class="comparison-category-head">
              <h3>{category}</h3>
              <span>{items.length}</span>
            </div>
            <div class="comparison-list-grid">
              {items.map((comparison) => (
                <a class="comparison-row" href={comparison.href}>
                  <span>{comparison.patternNames.join(" vs ")}</span>
                  <strong>{comparison.rule}</strong>
                  <div class="comparison-row-meta">
                    <small>{comparison.patternNames.length} patterns</small>
                    <small>{comparison.primaryCategory}</small>
                    <small>Source trail checked {comparison.lastVerified}</small>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
      <button class="secondary-action compare-load-more" type="button" data-compare-load-more>Show more comparisons</button>
      <noscript><p>The first 24 comparisons are shown above. Browse the sitemap or individual pattern pages for the full library.</p></noscript>
    </section>
  </div>

  <script is:inline define:vars={{ comparisonDataUrl: withBase("/comparison-search.json") }}>
    let comparisons = [];
    const form = document.querySelector("[data-compare-form]");
    const openLink = document.querySelector("[data-compare-open]");
    const status = document.querySelector("[data-compare-status]");
    const search = document.querySelector("[data-compare-search]");
    const categorySelect = document.querySelector("[data-compare-category-select]");
    const categoryButtons = [...document.querySelectorAll("[data-compare-category]")];
    const library = document.querySelector("[data-comparison-library]");
    const loadMore = document.querySelector("[data-compare-load-more]");
    const resultCount = document.querySelector("[data-compare-result-count]");
    const empty = document.querySelector("[data-compare-empty]");
    let activeCategory = "all";
    let visibleLimit = 24;
    let compareSearchTrackingTimer;

    function updateCompareLink() {
      if (!(form instanceof HTMLFormElement) || !(openLink instanceof HTMLButtonElement) || !status) return;
      const data = new FormData(form);
      const first = String(data.get("first") || "");
      const second = String(data.get("second") || "");
      const selected = [first, second].filter(Boolean).sort().join("|");
      const match = comparisons.find((comparison) => [...comparison.patternIds].sort().join("|") === selected);

      if (!first || !second) {
        openLink.disabled = true;
        status.textContent = "Choose a supported pair to compare.";
        return;
      }

      if (!match || first === second) {
        openLink.disabled = true;
        status.textContent = "No comparison page exists for that pair yet.";
        return;
      }

      openLink.disabled = false;
      openLink.dataset.href = match.href;
      status.textContent = match.title;
    }

    form?.addEventListener("change", updateCompareLink);
    openLink?.addEventListener("click", () => {
      if (openLink instanceof HTMLButtonElement && !openLink.disabled && openLink.dataset.href) {
        window.location.assign(openLink.dataset.href);
      }
    });

    function updateLibraryFilter() {
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
      const matches = comparisons.filter((comparison) => {
        const searchText = [
          comparison.title,
          comparison.summary,
          comparison.rule,
          comparison.patternNames.join(" "),
          comparison.categories.join(" ")
        ].join(" ").toLowerCase();
        return (activeCategory === "all" || comparison.primaryCategory === activeCategory) && (!query || searchText.includes(query));
      });
      const visible = matches.slice(0, visibleLimit);

      if (library) {
        library.replaceChildren();
        const groups = new Map();
        visible.forEach((comparison) => {
          const items = groups.get(comparison.primaryCategory) || [];
          items.push(comparison);
          groups.set(comparison.primaryCategory, items);
        });
        groups.forEach((items, category) => {
          const section = document.createElement("section");
          section.className = "comparison-category-section";
          const head = document.createElement("div");
          head.className = "comparison-category-head";
          const heading = document.createElement("h3");
          heading.textContent = category;
          const count = document.createElement("span");
          count.textContent = String(items.length);
          head.append(heading, count);
          const list = document.createElement("div");
          list.className = "comparison-list-grid";
          items.forEach((comparison) => {
            const link = document.createElement("a");
            link.className = "comparison-row";
            link.href = comparison.href;
            const names = document.createElement("span");
            names.textContent = comparison.patternNames.join(" vs ");
            const rule = document.createElement("strong");
            rule.textContent = comparison.rule;
            const meta = document.createElement("div");
            meta.className = "comparison-row-meta";
            [`${comparison.patternNames.length} patterns`, comparison.primaryCategory, `Source trail checked ${comparison.lastVerified}`].forEach((value) => {
              const item = document.createElement("small");
              item.textContent = value;
              meta.append(item);
            });
            link.append(names, rule, meta);
            list.append(link);
          });
          section.append(head, list);
          library.append(section);
        });
      }

      categoryButtons.forEach((button) => {
        button.classList.toggle("is-active", button.getAttribute("data-compare-category") === activeCategory);
      });
      if (categorySelect instanceof HTMLSelectElement) categorySelect.value = activeCategory;

      if (resultCount) {
        resultCount.textContent = `${Math.min(visible.length, matches.length)} of ${matches.length} ${matches.length === 1 ? "comparison" : "comparisons"} shown`;
      }
      if (empty) empty.hidden = matches.length > 0;
      if (loadMore instanceof HTMLButtonElement) {
        loadMore.hidden = visible.length >= matches.length;
        loadMore.textContent = `Show ${Math.min(24, matches.length - visible.length)} more comparisons`;
      }

      window.clearTimeout(compareSearchTrackingTimer);
      if (query) {
        compareSearchTrackingTimer = window.setTimeout(() => {
          const props = { surface: "comparison_directory", queryLength: query.length, resultCount: matches.length };
          if (typeof window.__trackAnalytics === "function") {
            window.__trackAnalytics("catalog_search", props);
            if (matches.length === 0) window.__trackAnalytics("zero_result_search", props);
          }
        }, 700);
      }
    }

    search?.addEventListener("input", () => {
      visibleLimit = 24;
      updateLibraryFilter();
    });
    categorySelect?.addEventListener("change", () => {
      activeCategory = categorySelect instanceof HTMLSelectElement ? categorySelect.value : "all";
      visibleLimit = 24;
      updateLibraryFilter();
    });
    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.getAttribute("data-compare-category") || "all";
        updateLibraryFilter();
      });
    });
    loadMore?.addEventListener("click", () => {
      visibleLimit += 24;
      updateLibraryFilter();
    });
    fetch(comparisonDataUrl)
      .then((response) => {
        if (!response.ok) throw new Error(`Comparison data request failed: ${response.status}`);
        return response.json();
      })
      .then((data) => {
        comparisons = Array.isArray(data) ? data : [];
        updateCompareLink();
        updateLibraryFilter();
      })
      .catch(() => {
        if (status) status.textContent = "Comparison finder is unavailable. Browse the comparison links below.";
        if (loadMore instanceof HTMLButtonElement) loadMore.hidden = true;
      });
  </script>
</BaseLayout>
