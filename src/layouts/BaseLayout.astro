---
import "../styles/global.css";
import { withBase } from "@/lib/paths";
import { SITE_NAME } from "@/lib/seo";

type Props = {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  image?: string;
};

const {
  title,
  description = "A source-backed guide to practical UX and UI patterns.",
  structuredData,
  image = "/assets/social-card.webp"
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalHref = new URL(currentPath, Astro.site ?? Astro.url).toString();
const sitemapHref = new URL(withBase("/sitemap.xml"), Astro.site ?? Astro.url).toString();
const socialImageHref = new URL(withBase(image), Astro.site ?? Astro.url).toString();
const jsonLd = structuredData ? JSON.stringify(structuredData).replaceAll("</script", "<\\/script") : undefined;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || "abacfae7-b939-4c0e-ae4b-fb950bba4b7f";
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || "https://cloud.umami.is/script.js";
const umamiDomains = import.meta.env.PUBLIC_UMAMI_DOMAINS || "uxpatternsguide.com";
const navItems = [
  { href: withBase("/"), label: "Home", icon: "#", active: currentPath === withBase("/") },
  { href: withBase("/patterns/"), label: "Patterns", icon: "A", active: currentPath.startsWith(withBase("/patterns/")) },
  { href: withBase("/resources/"), label: "Resources", icon: "::", active: currentPath.startsWith(withBase("/resources/")) },
  { href: withBase("/lab/"), label: "Lab", icon: "[]", active: currentPath.startsWith(withBase("/lab/")) },
  { href: withBase("/compare/"), label: "Compare", icon: "<>", active: currentPath.startsWith(withBase("/compare/")) },
  { href: withBase("/sources/"), label: "Sources", icon: "{}", active: currentPath.startsWith(withBase("/sources/")) },
  { href: withBase("/anti-patterns/"), label: "Anti-patterns", icon: "!", active: currentPath.startsWith(withBase("/anti-patterns/")) },
  { href: withBase("/agent/"), label: "Agent exports", icon: "->", active: currentPath.startsWith(withBase("/agent/")) }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="msvalidate.01" content="BD93A582145D3C26A00A7FB4FDE65BE5" />
    <meta name="naver-site-verification" content="da84aabacd3ceabd6ab1f06a452ee49de25539f7" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={socialImageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="UX Patterns Guide — source-backed patterns for product teams" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageHref} />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={withBase("/favicon-32x32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase("/favicon-48x48.png")} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} sizes="180x180" />
    <link rel="canonical" href={canonicalHref} />
    <link rel="sitemap" href={sitemapHref} type="application/xml" />
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    {import.meta.env.PROD && umamiWebsiteId && (
      <>
        <script is:inline>
          window.__analyticsQueue = window.__analyticsQueue || [];
          window.__trackAnalytics = function(eventName, props) {
            if (window.umami && typeof window.umami.track === "function") {
              window.umami.track(eventName, props);
              return;
            }
            window.__analyticsQueue.push([eventName, props]);
          };

          document.addEventListener("click", function(event) {
            var target = event.target instanceof Element ? event.target.closest("[data-analytics-event]") : null;
            var eventName = target && target.dataset.analyticsEvent;
            var props = {};

            if (target) {
              for (var key in target.dataset) {
                if (key === "analyticsEvent") continue;
                props[key] = target.dataset[key];
              }
            } else {
              var link = event.target instanceof Element ? event.target.closest("a[href]") : null;
              if (!(link instanceof HTMLAnchorElement)) return;
              var url = new URL(link.href, window.location.href);
              if (url.origin !== window.location.origin) return;
              var patternMatch = url.pathname.match(/\/patterns\/([^/]+)\/?$/);
              var comparisonMatch = url.pathname.match(/\/compare\/([^/]+)\/?$/);
              if (patternMatch) {
                eventName = "pattern_opened";
                props.patternId = decodeURIComponent(patternMatch[1]);
              } else if (comparisonMatch) {
                eventName = "comparison_opened";
                props.comparisonId = decodeURIComponent(comparisonMatch[1]);
              } else {
                return;
              }
              props.origin = link.dataset.analyticsOrigin || "internal_link";
            }

            if (eventName) window.__trackAnalytics(eventName, Object.keys(props).length ? props : undefined);
          });

          (function() {
            var elapsed = false;
            var depthReached = false;
            var sent = false;

            function pageType() {
              var path = window.location.pathname;
              if (/\/patterns\/[^/]+\/?$/.test(path)) return "pattern_detail";
              if (/\/sources\/[^/]+\/?$/.test(path)) return "source_detail";
              if (/\/compare\/[^/]+\/?$/.test(path)) return "comparison_detail";
              if (/\/resources\/[^/]+\/?$/.test(path)) return "resource_detail";
              if (/\/lab\/?$/.test(path)) return "lab";
              if (/\/patterns\/?$/.test(path)) return "pattern_directory";
              return path === "/" ? "home" : "other";
            }

            function maybeTrackEngagement() {
              if (sent || !elapsed || !depthReached) return;
              sent = true;
              window.__trackAnalytics("engaged_read", { seconds: 30, depth: 50, surface: pageType() });
              window.removeEventListener("scroll", checkDepth);
              window.removeEventListener("resize", checkDepth);
            }

            function checkDepth() {
              var documentHeight = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight);
              depthReached = documentHeight <= window.innerHeight || (window.scrollY + window.innerHeight) / documentHeight >= 0.5;
              maybeTrackEngagement();
            }

            window.setTimeout(function() {
              elapsed = true;
              maybeTrackEngagement();
            }, 30000);
            window.addEventListener("scroll", checkDepth, { passive: true });
            window.addEventListener("resize", checkDepth, { passive: true });
            window.requestAnimationFrame(checkDepth);
          })();
        </script>
        <script is:inline data-umami-src={umamiScriptUrl} data-umami-id={umamiWebsiteId} data-umami-domains={umamiDomains}>
          (function() {
            var currentScript = document.currentScript;
            var src = currentScript && currentScript.dataset.umamiSrc;
            var websiteId = currentScript && currentScript.dataset.umamiId;
            var domains = currentScript && currentScript.dataset.umamiDomains;
            if (!src || !websiteId) return;

            function loadUmami() {
              if (document.querySelector('script[data-website-id="' + websiteId + '"]')) return;
              var script = document.createElement("script");
              script.defer = true;
              script.src = src;
              script.dataset.websiteId = websiteId;
              if (domains) script.dataset.domains = domains;
              script.dataset.excludeHash = "true";
              script.dataset.excludeSearch = "true";
              script.dataset.performance = "true";
              script.addEventListener("load", function() {
                window.setTimeout(function() {
                  if (!window.umami || typeof window.umami.track !== "function") return;
                  var queued = window.__analyticsQueue.splice(0);
                  queued.forEach(function(item) {
                    window.umami.track(item[0], item[1]);
                  });
                }, 0);
              }, { once: true });
              document.head.appendChild(script);
            }

            loadUmami();
          })();
        </script>
      </>
    )}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase("/")}>UX Patterns Guide</a>
      <nav aria-label="Primary">
        {navItems.map((item) => (
          <a href={item.href} aria-current={item.active ? "page" : undefined}>
            <span class="nav-mark" aria-hidden="true">{item.icon}</span>
            {item.label}
          </a>
        ))}
      </nav>
      <button class="saved-items-trigger" type="button" data-saved-items-trigger aria-label="Saved items">
        Saved <span data-saved-count>0</span>
      </button>
    </header>
    <main>
      <slot />
    </main>
    <dialog class="saved-items-dialog" data-saved-items-dialog aria-labelledby="saved-items-title">
      <div class="saved-items-head">
        <h2 id="saved-items-title">Saved items</h2>
        <div class="saved-items-head-actions">
          <button type="button" data-copy-saved-list>Copy list</button>
          <button type="button" data-saved-items-close aria-label="Close saved items">Close</button>
        </div>
      </div>
      <div data-saved-items-list></div>
      <p class="saved-items-status" data-saved-items-status aria-live="polite"></p>
    </dialog>
    <script>
      import { track } from "@/lib/analytics";

      type SavedItem = { id: string; title: string; kind: string; url: string };
      const storageKey = "uxpg:saved-items";

      function readSavedItems(): SavedItem[] {
        try {
          const parsed = JSON.parse(localStorage.getItem(storageKey) || "[]");
          return Array.isArray(parsed) ? parsed.filter((item) => item?.id && item?.url) : [];
        } catch {
          return [];
        }
      }

      function writeSavedItems(items: SavedItem[]) {
        localStorage.setItem(storageKey, JSON.stringify(items));
        window.dispatchEvent(new CustomEvent("uxpg:saved-items", { detail: items }));
      }

      function updateSavedUI(items = readSavedItems()) {
        document.querySelectorAll<HTMLElement>("[data-saved-count]").forEach((node) => {
          node.textContent = String(items.length);
        });
        document.querySelectorAll<HTMLButtonElement>("[data-save-item]").forEach((button) => {
          const saved = items.some((item) => item.id === button.dataset.itemId);
          button.setAttribute("aria-pressed", String(saved));
          const icon = button.querySelector<HTMLElement>("[data-save-icon]");
          if (icon) icon.textContent = saved ? "✓" : "+";
          const label = button.querySelector<HTMLElement>("[data-save-label]");
          if (label) label.textContent = saved ? "Saved" : "Save";
        });
        const list = document.querySelector<HTMLElement>("[data-saved-items-list]");
        if (!list) return;
        list.replaceChildren();
        if (!items.length) {
          const empty = document.createElement("p");
          empty.className = "saved-empty";
          empty.textContent = "Save patterns and comparisons to build a browser-local review list.";
          list.append(empty);
          return;
        }
        items.forEach((item) => {
          const row = document.createElement("div");
          row.className = "saved-item";
          const link = document.createElement("a");
          link.href = item.url;
          const kind = document.createElement("span");
          kind.textContent = item.kind;
          const title = document.createElement("strong");
          title.textContent = item.title;
          link.append(kind, title);
          const remove = document.createElement("button");
          remove.type = "button";
          remove.dataset.removeSaved = item.id;
          remove.setAttribute("aria-label", `Remove ${item.title}`);
          remove.textContent = "Remove";
          row.append(link, remove);
          list.append(row);
        });
      }

      document.addEventListener("click", async (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const saveButton = target?.closest<HTMLButtonElement>("[data-save-item]");
        if (saveButton) {
          const id = saveButton.dataset.itemId || "";
          const items = readSavedItems();
          const existing = items.some((item) => item.id === id);
          const next = existing
            ? items.filter((item) => item.id !== id)
            : [...items, {
                id,
                title: saveButton.dataset.itemTitle || document.title,
                kind: saveButton.dataset.itemKind || "item",
                url: window.location.pathname
              }];
          writeSavedItems(next);
          updateSavedUI(next);
          track(existing ? "item_unsaved" : "item_saved", { itemId: id, surface: saveButton.dataset.itemKind || "unknown" });
          return;
        }

        const linkedInLink = target?.closest<HTMLAnchorElement>("[data-share-linkedin]");
        if (linkedInLink) {
          track("share_completed", { surface: window.location.pathname, method: "linkedin" });
          return;
        }

        const shareButton = target?.closest<HTMLButtonElement>("[data-share-page]");
        if (shareButton) {
          const wrapper = shareButton.closest<HTMLElement>(".engagement-actions");
          const status = wrapper?.querySelector<HTMLElement>("[data-action-status]");
          const title = shareButton.dataset.shareTitle || document.title;
          const text = shareButton.dataset.shareText || "";
          try {
            if (navigator.share) {
              track("share_opened", { surface: window.location.pathname });
              await navigator.share({ title, text, url: window.location.href });
              if (status) status.textContent = "Shared.";
              track("share_completed", { surface: window.location.pathname, method: "native" });
            } else {
              await navigator.clipboard.writeText(window.location.href);
              if (status) status.textContent = "Link copied.";
              track("link_copied", { surface: window.location.pathname });
            }
          } catch (error) {
            if (error instanceof DOMException && error.name === "AbortError") return;
            if (status) status.textContent = "Could not share. Copy the address from your browser.";
          }
          return;
        }

        const removeButton = target?.closest<HTMLButtonElement>("[data-remove-saved]");
        if (removeButton) {
          const next = readSavedItems().filter((item) => item.id !== removeButton.dataset.removeSaved);
          writeSavedItems(next);
          updateSavedUI(next);
        }
      });

      const savedDialog = document.querySelector<HTMLDialogElement>("[data-saved-items-dialog]");
      document.querySelector("[data-saved-items-trigger]")?.addEventListener("click", () => {
        updateSavedUI();
        savedDialog?.showModal();
      });
      document.querySelector("[data-saved-items-close]")?.addEventListener("click", () => savedDialog?.close());
      document.querySelector("[data-copy-saved-list]")?.addEventListener("click", async () => {
        const items = readSavedItems();
        const status = document.querySelector<HTMLElement>("[data-saved-items-status]");
        if (!items.length) {
          if (status) status.textContent = "Save an item before copying the list.";
          return;
        }
        const text = items
          .map((item) => `${item.title} — ${new URL(item.url, window.location.origin).toString()}`)
          .join("\n");
        try {
          await navigator.clipboard.writeText(text);
          if (status) status.textContent = `${items.length} saved ${items.length === 1 ? "item" : "items"} copied.`;
          track("saved_list_copied", { itemCount: items.length });
        } catch {
          if (status) status.textContent = "Could not copy the list. Try again from a secure browser window.";
        }
      });
      savedDialog?.addEventListener("click", (event) => {
        if (event.target === savedDialog) savedDialog.close();
      });
      window.addEventListener("uxpg:saved-items", (event) => updateSavedUI((event as CustomEvent<SavedItem[]>).detail));
      document.querySelectorAll<HTMLElement>("[data-share-label]").forEach((label) => {
        if (!navigator.share) label.textContent = "Copy link";
      });
      updateSavedUI();
    </script>
  </body>
</html>
